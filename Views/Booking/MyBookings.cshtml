@{
    ViewData["Title"]      = "My Bookings";
    ViewData["ActivePage"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="max-w-[1440px] mx-auto px-gutter py-xl">

    <!-- ═══ PAGE HEADER ═══ -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-primary mb-xs">My Bookings</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Manage and track all your reservations</p>
        </div>
        <button class="flex items-center gap-xs bg-surface-container-lowest border border-outline-variant
                       px-md py-sm rounded-lg text-on-surface font-label-md hover:bg-surface-container
                       transition-colors self-start md:self-auto">
            <span class="material-symbols-outlined text-[18px]">file_download</span>
            Export List
        </button>
    </header>

    <!-- ═══ FILTER TABS with sliding underline ═══ -->
    <section class="mb-xl overflow-x-auto hide-scrollbar">
        <div class="flex border-b border-outline-variant min-w-max relative" id="tabBar">
            <button onclick="filterBookings('All', this)"
                    class="tab-btn px-lg py-sm font-label-md text-label-md text-primary border-b-2 border-primary -mb-px">
                All
            </button>
            <button onclick="filterBookings('Upcoming', this)"
                    class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                           hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                Upcoming
            </button>
            <button onclick="filterBookings('Active', this)"
                    class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                           hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                Active
            </button>
            <button onclick="filterBookings('Completed', this)"
                    class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                           hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                Completed
            </button>
            <button onclick="filterBookings('Cancelled', this)"
                    class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                           hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                Cancelled
            </button>
        </div>
    </section>

    <!-- ═══ BOOKING CARDS ═══ -->
    <section class="grid grid-cols-1 gap-gutter" id="bookingsContainer">

        <!-- ── Card 1: UPCOMING ── -->
        <div class="booking-card" data-status="Upcoming">
            <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden
                        flex flex-col md:flex-row border border-outline-variant/20
                        hover:shadow-md transition-all group">

                <!-- Room Image -->
                <div class="md:w-[340px] md:min-w-[340px] relative overflow-hidden h-64 md:h-auto">
                    <img class="absolute inset-0 w-full h-full object-cover
                                transition-transform duration-500 group-hover:scale-105"
                         src="~/images/bookings/SkylineExecutiveSuite.png"
                         alt="Skyline Executive Suite" />
                    <div class="absolute top-md left-md">
                        <span class="bg-primary text-on-primary font-label-sm text-label-sm
                                     px-md py-xs rounded-full uppercase tracking-wider">Upcoming</span>
                    </div>
                </div>

                <!-- Content -->
                <div class="flex-1 p-lg flex flex-col justify-between gap-md">
                    <div class="flex flex-col md:flex-row justify-between items-start gap-sm">
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-primary">Skyline Executive Suite</h2>
                            <p class="text-on-surface-variant text-label-sm font-label-sm mt-xs">Booking #SWM-20240524</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="font-headline-md text-headline-md text-primary">$1,250.00</p>
                            <p class="text-on-surface-variant text-label-sm font-label-sm">Total for 3 nights</p>
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-md bg-surface-container
                                rounded-xl p-md border border-outline-variant/30">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Dates</p>
                            <p class="font-body-sm font-semibold text-on-surface">May 24 — May 27</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Duration</p>
                            <p class="font-body-sm font-semibold text-on-surface">3 Nights</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Guests</p>
                            <div class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant">group</span>
                                <p class="font-body-sm font-semibold text-on-surface">2 Guests</p>
                            </div>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Room</p>
                            <div class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant">door_front</span>
                                <p class="font-body-sm font-semibold text-on-surface">402</p>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-sm">
                        <div class="flex gap-sm flex-wrap">
                            <button class="bg-primary text-on-primary px-lg py-sm rounded-lg font-label-md
                                           hover:bg-primary-container transition-colors flex items-center gap-xs">
                                <span class="material-symbols-outlined text-[18px]">login</span>
                                Check-in Online
                            </button>
                            <button class="bg-surface-container-lowest border border-outline-variant text-on-surface
                                           px-lg py-sm rounded-lg font-label-md hover:bg-surface-container transition-colors">
                                View Details
                            </button>
                        </div>
                        <button class="flex items-center gap-xs text-error font-label-md hover:opacity-80 transition-opacity">
                            <span class="material-symbols-outlined text-[18px]">cancel</span>
                            Cancel Booking
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Card 2: ACTIVE ── -->
        <div class="booking-card" data-status="Active">
            <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden
                        flex flex-col md:flex-row border border-outline-variant/20
                        hover:shadow-md transition-all group">

                <div class="md:w-[340px] md:min-w-[340px] relative overflow-hidden h-64 md:h-auto">
                    <img class="absolute inset-0 w-full h-full object-cover
                                transition-transform duration-500 group-hover:scale-105"
                         src="~/images/bookings/UrbanDeluxeKing.png"
                         alt="Urban Deluxe King" />
                    <div class="absolute top-md left-md">
                        <span class="bg-green-600 text-white font-label-sm text-label-sm
                                     px-md py-xs rounded-full uppercase tracking-wider">Active</span>
                    </div>
                </div>

                <div class="flex-1 p-lg flex flex-col justify-between gap-md">
                    <div class="flex flex-col md:flex-row justify-between items-start gap-sm">
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-primary">Urban Deluxe King</h2>
                            <p class="text-on-surface-variant text-label-sm font-label-sm mt-xs">Booking #SWM-20240520</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="font-headline-md text-headline-md text-primary">$850.00</p>
                            <p class="text-on-surface-variant text-label-sm font-label-sm">Total for 5 nights</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-md bg-surface-container
                                rounded-xl p-md border border-outline-variant/30">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Dates</p>
                            <p class="font-body-sm font-semibold text-on-surface">May 20 — May 25</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Duration</p>
                            <p class="font-body-sm font-semibold text-on-surface">5 Nights</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Guests</p>
                            <div class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant">person</span>
                                <p class="font-body-sm font-semibold text-on-surface">1 Guest</p>
                            </div>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Room</p>
                            <div class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant">door_front</span>
                                <p class="font-body-sm font-semibold text-on-surface">205</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-sm">
                        <div class="flex gap-sm flex-wrap">
                            <button class="bg-primary text-on-primary px-lg py-sm rounded-lg font-label-md
                                           hover:bg-primary-container transition-colors">
                                View Details
                            </button>
                        </div>
                        <div class="flex items-center gap-xs text-green-600 font-label-md">
                            <span class="material-symbols-outlined text-[18px] animate-pulse">wifi_tethering</span>
                            Currently staying
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Card 3: COMPLETED ── -->
        <div class="booking-card" data-status="Completed">
            <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden
                        flex flex-col md:flex-row border border-outline-variant/20
                        hover:shadow-md transition-all group">

                <div class="md:w-[340px] md:min-w-[340px] relative overflow-hidden h-64 md:h-auto">
                    <img class="absolute inset-0 w-full h-full object-cover opacity-90
                                transition-transform duration-500 group-hover:scale-105"
                         src="~/images/bookings/GrandFamilyLoft.png"
                         alt="Grand Family Loft" />
                    <div class="absolute top-md left-md">
                        <span class="bg-secondary text-white font-label-sm text-label-sm
                                     px-md py-xs rounded-full uppercase tracking-wider">Completed</span>
                    </div>
                </div>

                <div class="flex-1 p-lg flex flex-col justify-between gap-md">
                    <div class="flex flex-col md:flex-row justify-between items-start gap-sm">
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-primary">Grand Family Loft</h2>
                            <p class="text-on-surface-variant text-label-sm font-label-sm mt-xs">Booking #SWM-20240510</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="font-headline-md text-headline-md text-primary">$1,600.00</p>
                            <p class="text-on-surface-variant text-label-sm font-label-sm">Total for 2 nights</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-md bg-surface-container
                                rounded-xl p-md border border-outline-variant/30">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Dates</p>
                            <p class="font-body-sm font-semibold text-on-surface">May 10 — May 12</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Duration</p>
                            <p class="font-body-sm font-semibold text-on-surface">2 Nights</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Guests</p>
                            <div class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant">groups</span>
                                <p class="font-body-sm font-semibold text-on-surface">4 Guests</p>
                            </div>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Room</p>
                            <div class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant">door_front</span>
                                <p class="font-body-sm font-semibold text-on-surface">101</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-sm">
                        <div class="flex gap-sm flex-wrap">
                            <button class="bg-surface-container-lowest border border-outline-variant text-on-surface
                                           px-lg py-sm rounded-lg font-label-md hover:bg-surface-container transition-colors">
                                View Details
                            </button>
                            <button class="bg-surface-container-lowest border border-outline-variant text-on-surface
                                           px-lg py-sm rounded-lg font-label-md hover:bg-surface-container transition-colors">
                                Book Again
                            </button>
                        </div>
                        <button class="flex items-center gap-xs text-on-surface-variant font-label-md
                                       hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                            Download Invoice
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <!-- ═══ PAGINATION ═══ -->
    <div class="flex items-center justify-center gap-xs mt-xl">
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors text-on-surface-variant">
            <span class="material-symbols-outlined text-sm">chevron_left</span>
        </button>
        <button class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center
                       font-bold text-label-md">1</button>
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors font-label-md text-on-surface-variant">2</button>
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors font-label-md text-on-surface-variant">3</button>
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors font-label-md text-on-surface-variant">4</button>
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors font-label-md text-on-surface-variant">5</button>
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors font-label-md text-on-surface-variant">6</button>
        <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center
                       hover:bg-surface-container transition-colors text-on-surface-variant">
            <span class="material-symbols-outlined text-sm">chevron_right</span>
        </button>
    </div>

</main>

@section Scripts {
<script>
    function filterBookings(status, btn) {
        // Update tab styles
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('text-primary', 'border-primary');
            b.classList.add('text-on-surface-variant', 'border-transparent');
        });
        btn.classList.remove('text-on-surface-variant', 'border-transparent');
        btn.classList.add('text-primary', 'border-primary');

        // Filter cards
        document.querySelectorAll('.booking-card').forEach(card => {
            const cardStatus = card.dataset.status;
            if (status === 'All' || cardStatus === status) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
}
