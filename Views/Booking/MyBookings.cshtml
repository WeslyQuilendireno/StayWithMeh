@model StayWithMeh.Models.MyBookingsViewModel
@{
    ViewData["Title"]      = "My Bookings";
    ViewData["ActivePage"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .empty-state {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 80px 24px; text-align: center;
    }
    .empty-icon-wrap {
        width: 80px; height: 80px; border-radius: 50%;
        background: #efedf0;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 24px;
    }
</style>

<main class="max-w-[1440px] mx-auto px-gutter py-xl">

    <header class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-primary mb-xs">My Bookings</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Manage and track all your reservations</p>
        </div>
        @if (Model.Bookings.Any())
        {
            <button class="flex items-center gap-xs bg-surface-container-lowest border border-outline-variant
                           px-md py-sm rounded-lg text-on-surface font-label-md hover:bg-surface-container
                           transition-colors self-start md:self-auto">
                <span class="material-symbols-outlined text-[18px]">file_download</span>
                Export List
            </button>
        }
    </header>

    @if (!Model.Bookings.Any())
    {
        <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm">
            <div class="empty-state">
                <div class="empty-icon-wrap">
                    <span class="material-symbols-outlined text-outline" style="font-size:40px">calendar_today</span>
                </div>
                <h2 class="font-headline-md text-headline-md text-primary mb-sm">No bookings yet</h2>
                <p class="text-body-md text-on-surface-variant max-w-sm mb-xl">
                    You haven't made any reservations. Browse our rooms and book your next stay.
                </p>
                <a asp-controller="Room" asp-action="Index"
                   class="flex items-center gap-xs bg-primary text-on-primary px-xl py-md rounded-xl
                          font-label-md text-label-md hover:bg-primary-container transition-colors">
                    <span class="material-symbols-outlined">explore</span>
                    Browse Rooms
                </a>
            </div>
        </div>
    }
    else
    {
        <section class="mb-xl overflow-x-auto hide-scrollbar">
            <div class="flex border-b border-outline-variant min-w-max relative" id="tabBar">
                <button onclick="filterBookings('All', this)"
                        class="tab-btn px-lg py-sm font-label-md text-label-md text-primary border-b-2 border-primary -mb-px">
                    All
                </button>
                <button onclick="filterBookings('upcoming', this)"
                        class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                               hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                    Upcoming
                </button>
                <button onclick="filterBookings('active', this)"
                        class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                               hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                    Active
                </button>
                <button onclick="filterBookings('completed', this)"
                        class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                               hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                    Completed
                </button>
                <button onclick="filterBookings('cancelled', this)"
                        class="tab-btn px-lg py-sm font-label-md text-label-md text-on-surface-variant
                               hover:text-primary transition-colors border-b-2 border-transparent -mb-px">
                    Cancelled
                </button>
            </div>
        </section>

        <section class="grid grid-cols-1 gap-gutter" id="bookingsContainer">
            @foreach (var booking in Model.Bookings)
            {
                var nights = (booking.CheckOut - booking.CheckIn).Days;
                var room   = Model.RoomsById.TryGetValue(booking.RoomId, out var r) ? r : null;

                <div class="booking-card" data-status="@booking.Status.ToLower()">
                    <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden
                                flex flex-col md:flex-row border border-outline-variant/20
                                hover:shadow-md transition-all group">

                        <div class="md:w-[340px] md:min-w-[340px] relative overflow-hidden h-64 md:h-auto bg-surface-container">
                            @if (room is not null)
                            {
                                <img class="absolute inset-0 w-full h-full object-cover
                                            transition-transform duration-500 group-hover:scale-105"
                                     src="@room.ImageUrl" alt="@room.RoomType" />
                            }
                            <div class="absolute top-md left-md">
                                <span class="bg-primary text-on-primary font-label-sm text-label-sm
                                             px-md py-xs rounded-full uppercase tracking-wider">@booking.Status</span>
                            </div>
                        </div>

                        <div class="flex-1 p-lg flex flex-col justify-between gap-md">
                            <div class="flex flex-col md:flex-row justify-between items-start gap-sm">
                                <div>
                                    <h2 class="font-headline-sm text-headline-sm text-primary">
                                        @(room is not null ? $"{room.RoomType} — Room {room.RoomNumber}" : "Booking")
                                    </h2>
                                    <p class="text-on-surface-variant text-label-sm font-label-sm mt-xs">Booking #@booking.Id.Substring(0, 8).ToUpper()</p>
                                </div>
                                <div class="text-right shrink-0">
                                    <p class="font-headline-md text-headline-md text-primary">$@booking.TotalAmount.ToString("0.00")</p>
                                    <p class="text-on-surface-variant text-label-sm font-label-sm">Total for @nights night@(nights != 1 ? "s" : "")</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 md:grid-cols-3 gap-md bg-surface-container
                                        rounded-xl p-md border border-outline-variant/30">
                                <div>
                                    <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Check-in</p>
                                    <p class="font-body-sm font-semibold text-on-surface">@booking.CheckIn.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div>
                                    <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Check-out</p>
                                    <p class="font-body-sm font-semibold text-on-surface">@booking.CheckOut.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div>
                                    <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Duration</p>
                                    <p class="font-body-sm font-semibold text-on-surface">@nights Night@(nights != 1 ? "s" : "")</p>
                                </div>
                            </div>

                            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-sm">
                                <div class="flex gap-sm flex-wrap">
                                    <a asp-controller="Room" asp-action="Details" asp-route-id="@booking.RoomId"
                                       class="bg-surface-container-lowest border border-outline-variant text-on-surface
                                              px-lg py-sm rounded-lg font-label-md hover:bg-surface-container transition-colors">
                                        View Room
                                    </a>
                                </div>
                                @if (booking.Status.Equals("pending", StringComparison.OrdinalIgnoreCase) ||
                                     booking.Status.Equals("upcoming", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="flex items-center gap-xs text-error font-label-md hover:opacity-80 transition-opacity">
                                        <span class="material-symbols-outlined text-[18px]">cancel</span>
                                        Cancel Booking
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

</main>

@section Scripts {
<script>
    function filterBookings(status, btn) {
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('text-primary', 'border-primary');
            b.classList.add('text-on-surface-variant', 'border-transparent');
        });
        btn.classList.remove('text-on-surface-variant', 'border-transparent');
        btn.classList.add('text-primary', 'border-primary');

        document.querySelectorAll('.booking-card').forEach(card => {
            const cardStatus = card.dataset.status;
            card.style.display = (status === 'All' || cardStatus === status) ? 'block' : 'none';
        });
    }
</script>
}
