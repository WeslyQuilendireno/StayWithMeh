@model StayWithMeh.Models.SuperAdminDashboardViewModel
@{
    ViewData["Title"]           = "Owner Dashboard";
    ViewData["ActiveStaffPage"] = "Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    var assignableRoles = (string[])ViewData["AssignableRoles"]!;
}

<!-- Stat cards — real data only, no fabricated cost-based metrics -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-md mb-lg">
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
        <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Occupancy</p>
        <p class="text-display-lg font-bold text-primary mt-xs">@Model.OccupancyPercent%</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
        <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Total Revenue</p>
        <p class="text-display-lg font-bold text-primary mt-xs">$@Model.TotalRevenue.ToString("N0")</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
        <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Total Bookings</p>
        <p class="text-display-lg font-bold text-primary mt-xs">@Model.Bookings.Count</p>
    </div>
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg opacity-60">
        <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Net Profit Margin</p>
        <p class="text-display-lg font-bold text-on-surface-variant mt-xs">—</p>
        <p class="text-[10px] text-on-surface-variant">Needs cost tracking, not built yet</p>
    </div>
</div>

<div class="grid grid-cols-12 gap-lg">

    <!-- Role Management — the core SuperAdmin function -->
    <div class="col-span-12 lg:col-span-8 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 overflow-hidden">
        <div class="p-lg border-b border-outline-variant/10">
            <h2 class="text-headline-sm font-headline-sm text-primary">Role Management</h2>
            <p class="text-body-sm text-on-surface-variant mt-1">Change any account's role across the system.</p>
        </div>
        <table class="w-full text-left">
            <thead>
                <tr class="text-label-sm text-on-surface-variant uppercase tracking-widest bg-surface-container-low">
                    <th class="px-lg py-sm">Account</th>
                    <th class="px-lg py-sm">Current Role</th>
                    <th class="px-lg py-sm">Change To</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model.Profiles.OrderBy(p => p.Email))
                {
                    var (badgeBg, badgeText) = profile.Role switch
                    {
                        "SuperAdmin"   => ("bg-primary", "text-on-primary"),
                        "Manager"      => ("bg-primary-container", "text-on-primary-container"),
                        "Receptionist" => ("bg-green-100", "text-green-800"),
                        "Housekeeper"  => ("bg-amber-100", "text-amber-800"),
                        _              => ("bg-surface-container", "text-on-surface-variant")
                    };

                    <tr class="border-b border-outline-variant/10 last:border-0">
                        <td class="px-lg py-md">
                            <p class="text-label-md font-bold text-on-surface">@(profile.FullName ?? "—")</p>
                            <p class="text-body-sm text-on-surface-variant">@profile.Email</p>
                        </td>
                        <td class="px-lg py-md">
                            <span class="px-md py-xs rounded-full text-label-sm font-bold @badgeBg @badgeText">
                                @profile.Role
                            </span>
                        </td>
                        <td class="px-lg py-md">
                            @if (profile.Role == "SuperAdmin")
                            {
                                <span class="text-label-sm text-on-surface-variant italic">Owner accounts are managed manually</span>
                            }
                            else
                            {
                                <select onchange="updateRole('@profile.Id', this.value)"
                                        class="border border-outline-variant rounded-lg px-sm py-xs text-label-sm
                                               focus:ring-2 focus:ring-primary focus:border-transparent">
                                    <option value="">Select role&hellip;</option>
                                    @foreach (var role in assignableRoles)
                                    {
                                        <option value="@role" selected="@(role == profile.Role)">@role</option>
                                    }
                                </select>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Privileged Accounts -->
    <aside class="col-span-12 lg:col-span-4 flex flex-col gap-lg">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
            <h3 class="text-label-sm font-bold text-on-surface-variant uppercase tracking-widest mb-md">Privileged Accounts</h3>
            <div class="space-y-sm">
                @foreach (var profile in Model.PrivilegedAccounts)
                {
                    var initials = string.Concat((profile.FullName ?? profile.Email)
                        .Split(' ').Take(2).Select(w => w[0])).ToUpper();

                    <div class="flex items-center gap-md p-sm rounded-xl hover:bg-surface-container-low transition-colors">
                        <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container
                                    flex items-center justify-center font-bold text-label-sm">
                            @initials
                        </div>
                        <div class="flex-1">
                            <p class="text-label-md font-bold text-on-surface">@(profile.FullName ?? profile.Email)</p>
                            <p class="text-body-sm text-on-surface-variant">@profile.Role</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!--
            Freeze All Outgoing is a major standalone feature (a real
            system-wide transaction lock) that doesn't exist yet —
            shown disabled rather than faked as functional.
        -->
        <div class="bg-error/5 border border-error/20 rounded-2xl p-lg">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-label-md font-bold text-error">Freeze All Outgoing</p>
                    <p class="text-body-sm text-on-surface-variant">Emergency financial lock</p>
                </div>
                <span class="material-symbols-outlined text-error/40">lock</span>
            </div>
            <p class="text-[10px] text-on-surface-variant mt-md">Not implemented — requires a system-wide transaction gate.</p>
        </div>
    </aside>

    <!-- Financial Transaction Log -->
    <div class="col-span-12 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 overflow-hidden">
        <div class="p-lg border-b border-outline-variant/10 flex items-center justify-between">
            <h2 class="text-headline-sm font-headline-sm text-primary">Financial Transactions</h2>
            <span class="text-[10px] text-on-surface-variant uppercase tracking-widest">
                Real bookings &middot; no staff authorization step exists yet
            </span>
        </div>
        @if (!Model.Bookings.Any())
        {
            <p class="text-body-sm text-on-surface-variant text-center py-xl">No transactions yet.</p>
        }
        else
        {
            <table class="w-full text-left">
                <thead>
                    <tr class="text-label-sm text-on-surface-variant uppercase tracking-widest bg-surface-container-low">
                        <th class="px-lg py-sm">Booking</th>
                        <th class="px-lg py-sm">Check-in</th>
                        <th class="px-lg py-sm">Amount</th>
                        <th class="px-lg py-sm">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings.OrderByDescending(b => b.CheckIn))
                    {
                        <tr class="border-b border-outline-variant/10 last:border-0">
                            <td class="px-lg py-md text-label-md font-bold text-on-surface">
                                #@booking.Id.Substring(0, 8).ToUpper()
                            </td>
                            <td class="px-lg py-md text-body-sm text-on-surface-variant">
                                @booking.CheckIn.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-lg py-md text-label-md font-bold text-green-700">
                                +$@booking.TotalAmount.ToString("N2")
                            </td>
                            <td class="px-lg py-md">
                                <span class="px-md py-xs rounded-full text-label-sm font-bold bg-green-100 text-green-800 capitalize">
                                    @booking.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
<script>
    async function updateRole(userId, newRole) {
        if (!newRole) return;
        try {
            const res = await fetch('/SuperAdmin/UpdateRole', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: userId, newRole: newRole })
            });
            if (!res.ok) throw new Error('Update failed');
            location.reload();
        } catch {
            alert('Failed to update role. Please try again.');
        }
    }
</script>
}
