@{
    ViewData["Title"]      = "Browse Rooms";
    ViewData["ActivePage"] = "Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-[1440px] mx-auto px-gutter py-xl">

    <!-- ═══ PAGE HEADER ═══ -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-primary">Browse Rooms</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
                Find the perfect room for your stay
            </p>
        </div>
        <!-- Search -->
        <div class="relative w-full md:w-72">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input class="w-full pl-10 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant
                          rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-body-sm"
                   placeholder="Search rooms..." type="text" id="searchInput" />
        </div>
    </div>

    <!-- ═══ FILTER TABS ═══ -->
    <div class="border-b border-outline-variant mb-xl overflow-x-auto hide-scrollbar">
        <div class="flex min-w-max">
            <button onclick="filterRooms('All Rooms', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-primary
                           border-b-2 border-primary -mb-px transition-colors">
                All Rooms
            </button>
            <button onclick="filterRooms('Available', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">
                Available
            </button>
            <button onclick="filterRooms('Suite', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">
                Suites
            </button>
            <button onclick="filterRooms('Standard', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">
                Standard
            </button>
            <button onclick="filterRooms('Family', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">
                Family
            </button>
        </div>
    </div>

    <!-- ═══ ROOM GRID ═══ -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-lg" id="roomGrid">

        <!-- ── Skyline Executive Suite ── -->
        <div class="room-card bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20
                    overflow-hidden flex flex-col hover:shadow-lg hover:-translate-y-1 transition-all group"
             data-type="Suite" data-status="Available">
            <div class="relative h-52 overflow-hidden">
                <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                     src="~/images/rooms/Rooms_Dashboard/SkylineExecutiveSuiteRoom.png"
                     alt="Skyline Executive Suite" />
                <div class="absolute top-4 right-4">
                    <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full font-label-sm
                                 text-label-sm flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                        Available
                    </span>
                </div>
                <!-- Save button -->
                <button class="absolute top-4 left-4 w-9 h-9 bg-white/80 backdrop-blur-sm rounded-full
                               flex items-center justify-center hover:bg-white transition-colors shadow-sm"
                        onclick="toggleSave(this)">
                    <span class="material-symbols-outlined text-primary text-[20px]">favorite_border</span>
                </button>
            </div>
            <div class="p-lg flex flex-col flex-grow">
                <div class="flex justify-between items-start mb-xs">
                    <p class="text-on-surface-variant font-label-sm text-label-sm">Room 402, 4th Floor</p>
                    <div class="flex items-center gap-1 text-primary">
                        <span class="material-symbols-outlined text-[16px]"
                              style="font-variation-settings:'FILL' 1">star</span>
                        <span class="font-bold text-label-sm">4.9</span>
                    </div>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-primary mb-sm">Skyline Executive Suite</h3>
                <div class="flex flex-wrap gap-md mb-lg">
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">king_bed</span>
                        <span class="text-body-sm">King Bed</span>
                    </div>
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">wifi</span>
                        <span class="text-body-sm">WiFi</span>
                    </div>
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">balcony</span>
                        <span class="text-body-sm">Balcony</span>
                    </div>
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">location_city</span>
                        <span class="text-body-sm">City View</span>
                    </div>
                </div>
                <div class="mt-auto pt-lg border-t border-outline-variant/30
                            flex justify-between items-center">
                    <div>
                        <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Per Night</p>
                        <div class="flex items-center gap-2">
                            <span class="font-headline-sm text-headline-sm text-primary">$450.00</span>
                            <span class="text-[10px] bg-secondary-fixed text-on-secondary-fixed
                                         px-2 py-0.5 rounded font-medium">AI Priced</span>
                        </div>
                    </div>
                    <div class="flex gap-sm">
                        <a asp-controller="Room" asp-action="Details" asp-route-id="1"
                           class="border border-outline-variant text-primary px-md py-sm rounded-xl
                                  font-label-md hover:bg-surface-container transition-colors text-sm">
                            Details
                        </a>
                        <a asp-controller="Room" asp-action="Details" asp-route-id="1"
                           class="bg-primary text-on-primary px-md py-sm rounded-xl font-label-md
                                  hover:bg-primary-container transition-colors text-sm">
                            Book Now
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Superior Twin Room ── -->
