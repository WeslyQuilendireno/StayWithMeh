</div>

<!-- ═══════════════════════════════════════════════
     BOOKING MODAL
═══════════════════════════════════════════════ -->
<div id="bookingModal" onclick="handleModalBackdropClick(event)">
    <div id="modalPanel">

        <!-- Modal Header -->
        <div class="flex items-center justify-between p-lg border-b border-outline-variant/30 sticky top-0 bg-white z-10">
            <div>
                <h2 id="modalRoomName" class="font-headline-sm text-headline-sm text-primary"></h2>
                <p id="modalRoomFloor" class="text-body-sm text-on-surface-variant mt-1"></p>
            </div>
            <button onclick="closeBookingModal()"
                    class="w-10 h-10 rounded-full hover:bg-surface-container flex items-center justify-center transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="flex flex-col md:flex-row gap-lg p-lg">

            <!-- Left: Image + Info -->
            <div class="flex-1 space-y-md">

                <!-- Image carousel -->
                <div class="relative h-[260px] rounded-xl overflow-hidden group">
                    <img id="modalCarouselImg"
                         class="w-full h-full object-cover"
                         src="" alt="Room" />
                    <div id="modalRoomTypeBadge"
                         class="absolute top-3 left-3 bg-primary text-white text-label-sm font-label-sm
                                px-md py-xs rounded-full uppercase tracking-wider"></div>
                    <span class="bg-green-100 text-green-800 font-label-sm text-label-sm px-md py-xs
                                 rounded-full absolute top-3 right-3 flex items-center gap-xs">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Available
                    </span>
                    <button onclick="modalPrevSlide()"
                            class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/80
                                   flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="material-symbols-outlined text-primary text-[18px]">chevron_left</span>
                    </button>
                    <button onclick="modalNextSlide()"
                            class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/80
                                   flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="material-symbols-outlined text-primary text-[18px]">chevron_right</span>
                    </button>
                </div>

                <!-- Thumbnails -->
                <div class="flex gap-sm overflow-x-auto hide-scrollbar" id="modalThumbs">
                    <!-- populated by JS -->
                </div>

                <!-- Amenities -->
                <div class="grid grid-cols-4 gap-sm">
                    <div class="flex flex-col items-center text-center p-sm bg-surface-container-low rounded-xl">
