@model List<StayWithMeh.Models.Room>
@{
    ViewData["Title"]      = "Browse Rooms";
    ViewData["ActivePage"] = "Rooms";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roomTypeDisplay = new Dictionary<string, string>
    {
        { "Business Suite", "Business Suite" },
        { "Standard",       "Standard" },
        { "Deluxe Suite",   "Deluxe Suite" },
        { "Family Suite",   "Family Suite" }
    };

    var roomTypeIcons = new Dictionary<string, (string icon, string label)>
    {
        { "Business Suite", ("desk", "Work Desk") },
        { "Standard",       ("king_bed", "King Bed") },
        { "Deluxe Suite",   ("waves", "Ocean View") },
        { "Family Suite",   ("family_restroom", "Sleeps 4") }
    };
}

<style>
    #bookingModal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: rgba(3,22,53,0.55);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    #bookingModal.show { display: flex; }

    #modalPanel {
        background: white;
        border-radius: 1.5rem;
        width: 100%;
        max-width: 960px;
        max-height: 90vh;
        overflow-y: auto;
        scrollbar-width: none;
        animation: modalSlideUp 0.3s cubic-bezier(0.4,0,0.2,1);
    }
    #modalPanel::-webkit-scrollbar { display: none; }

    @@keyframes modalSlideUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .booking-input { transition: border-color 0.15s, box-shadow 0.15s; }
    .booking-input:focus {
        outline: none;
        border-color: #031635;
        box-shadow: 0 0 0 2px rgba(3,22,53,0.12);
    }

    #bookingSuccess {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(3,22,53,0.55);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    #bookingSuccess.show { display: flex; }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .success-card { animation: fadeUp 0.3s ease; }

    #modalCarouselImg { transition: opacity 0.25s ease; }
    .modal-thumb {
        cursor: pointer;
        transition: all 0.15s;
        flex-shrink: 0;
        width: 72px;
        height: 52px;
        border-radius: 8px;
        overflow: hidden;
    }
    .modal-thumb.active { outline: 2px solid #031635; outline-offset: 2px; }

    .feature-pill {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 99px;
        background: #efedf0; font-size: 12px; font-weight: 500; color: #44474e;
    }
</style>

<div class="max-w-[1440px] mx-auto px-gutter py-xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-xl">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-primary">Browse Rooms</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
                Find the perfect room for your stay
            </p>
        </div>
        <div class="relative w-full md:w-72">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input class="w-full pl-10 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant
                          rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent text-body-sm"
                   placeholder="Search rooms..." type="text" id="searchInput" />
        </div>
    </div>

    <div class="border-b border-outline-variant mb-xl overflow-x-auto hide-scrollbar">
        <div class="flex min-w-max">
            <button onclick="filterRooms('All Rooms', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-primary
                           border-b-2 border-primary -mb-px transition-colors">All Rooms</button>
            <button onclick="filterRooms('Available', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">Available</button>
            <button onclick="filterRooms('Deluxe Suite', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">Suites</button>
            <button onclick="filterRooms('Standard', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">Standard</button>
            <button onclick="filterRooms('Family Suite', this)"
                    class="room-tab py-4 px-lg font-label-md text-label-md text-on-surface-variant
                           border-b-2 border-transparent -mb-px hover:text-primary transition-colors">Family</button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-lg" id="roomGrid">

        @foreach (var room in Model)
        {
            var isAvailable = room.Status.Equals("available", StringComparison.OrdinalIgnoreCase);
            var icon  = roomTypeIcons.TryGetValue(room.RoomType, out var iv) ? iv.icon  : "bed";
            var label = roomTypeIcons.TryGetValue(room.RoomType, out var lv) ? lv.label : "Room";

            <div class="room-card bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/20
                        overflow-hidden flex flex-col hover:shadow-lg @(isAvailable ? "hover:-translate-y-1" : "") transition-all group"
                 data-type="@room.RoomType" data-status="@(isAvailable ? "Available" : "Unavailable")"
                 data-room-id="@room.Id" data-price="@room.PricePerNight.ToString("0.00")"
                 data-name="@($"Room {room.RoomNumber}")" data-floor="@($"Room {room.RoomNumber}")"
                 data-type-label="@room.RoomType" data-base="@room.BasePrice.ToString("0")">

                <div class="relative h-52 overflow-hidden">
                    <img class="w-full h-full object-cover @(isAvailable ? "" : "opacity-80") transition-transform duration-500 group-hover:scale-105"
                         src="@room.ImageUrl" alt="Room @room.RoomNumber" />
                    <div class="absolute top-4 right-4">
                        @if (isAvailable)
                        {
                            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full font-label-sm text-label-sm flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span> Available
                            </span>
                        }
                        else
                        {
                            <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full font-label-sm text-label-sm">Unavailable</span>
                        }
                    </div>
                    <button class="absolute top-4 left-4 w-9 h-9 bg-white/80 backdrop-blur-sm rounded-full
                                   flex items-center justify-center hover:bg-white transition-colors shadow-sm"
                            onclick="toggleSave(this)">
                        <span class="material-symbols-outlined text-primary text-[20px]">favorite_border</span>
                    </button>
                </div>
                <div class="p-lg flex flex-col flex-grow @(isAvailable ? "" : "opacity-80")">
                    <div class="flex justify-between items-start mb-xs">
                        <p class="text-on-surface-variant font-label-sm text-label-sm room-floor">Room @room.RoomNumber</p>
                        <div class="flex items-center gap-1 text-primary">
                            <span class="material-symbols-outlined text-[16px]" style="font-variation-settings:'FILL' 1">star</span>
                            <span class="font-bold text-label-sm">4.8</span>
                        </div>
                    </div>
                    <h3 class="font-headline-sm text-headline-sm text-primary mb-sm">@room.RoomType — Room @room.RoomNumber</h3>
                    <p class="text-on-surface-variant font-body-sm mb-lg">@room.Description</p>
                    <div class="flex flex-wrap gap-md mb-lg">
                        <div class="flex items-center gap-1 text-on-surface-variant">
                            <span class="material-symbols-outlined text-[18px]">@icon</span>
                            <span class="text-body-sm">@label</span>
                        </div>
                        <div class="flex items-center gap-1 text-on-surface-variant">
                            <span class="material-symbols-outlined text-[18px]">wifi</span>
                            <span class="text-body-sm">WiFi</span>
                        </div>
                    </div>
                    <div class="mt-auto pt-lg border-t border-outline-variant/30 flex justify-between items-center">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-outline tracking-widest mb-1">Per Night</p>
                            <span class="font-headline-sm text-headline-sm text-primary">$@room.PricePerNight.ToString("0.00")</span>
                        </div>
                        <div class="flex gap-sm">
                            <a asp-controller="Room" asp-action="Details" asp-route-id="@room.Id"
                               class="border border-outline-variant text-primary px-md py-sm rounded-xl font-label-md hover:bg-surface-container transition-colors text-sm">Details</a>
                            @if (isAvailable)
                            {
                                <button onclick="openBookingModal(this.closest('.room-card'))"
                                        class="bg-primary text-on-primary px-md py-sm rounded-xl font-label-md hover:bg-primary-container transition-colors text-sm">Book Now</button>
                            }
                            else
                            {
                                <button class="bg-surface-container text-outline px-md py-sm rounded-xl font-label-md cursor-not-allowed text-sm">Join Waitlist</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="mt-xl flex justify-between items-center bg-surface-container-lowest p-md
                rounded-xl shadow-sm border border-outline-variant/20">
        <p class="text-body-sm text-on-surface-variant">
            Showing <span class="font-bold text-on-surface">@Model.Count</span> of
            <span class="font-bold text-on-surface">@Model.Count</span> rooms
        </p>
    </div>
</div>

<div id="bookingModal" onclick="handleModalBackdropClick(event)">
    <div id="modalPanel">

        <div class="flex items-center justify-between p-lg border-b border-outline-variant/30 sticky top-0 bg-white z-10">
            <div>
                <h2 id="modalRoomName" class="font-headline-sm text-headline-sm text-primary"></h2>
                <p id="modalRoomFloor" class="text-body-sm text-on-surface-variant mt-1"></p>
            </div>
            <button onclick="closeBookingModal()"
                    class="w-10 h-10 rounded-full hover:bg-surface-container flex items-center justify-center transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
        </div>

        <div class="flex flex-col md:flex-row gap-lg p-lg">

            <div class="flex-1 space-y-md">

                <div class="relative h-[260px] rounded-xl overflow-hidden group">
                    <img id="modalCarouselImg" class="w-full h-full object-cover" src="" alt="Room" />
                    <div id="modalRoomTypeBadge"
                         class="absolute top-3 left-3 bg-primary text-white text-label-sm font-label-sm
                                px-md py-xs rounded-full uppercase tracking-wider"></div>
                    <span class="bg-green-100 text-green-800 font-label-sm text-label-sm px-md py-xs
                                 rounded-full absolute top-3 right-3 flex items-center gap-xs">
                        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Available
                    </span>
                    <button onclick="modalPrevSlide()"
                            class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/80
                                   flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="material-symbols-outlined text-primary text-[18px]">chevron_left</span>
                    </button>
                    <button onclick="modalNextSlide()"
                            class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white/80
                                   flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="material-symbols-outlined text-primary text-[18px]">chevron_right</span>
                    </button>
                </div>

                <div class="flex gap-sm overflow-x-auto hide-scrollbar" id="modalThumbs"></div>

                <div class="grid grid-cols-4 gap-sm">
                    <div class="flex flex-col items-center text-center p-sm bg-surface-container-low rounded-xl">
                        <span class="material-symbols-outlined text-primary text-2xl mb-xs">wifi</span>
                        <p class="text-[11px] font-semibold text-on-surface">Wi-Fi</p>
                    </div>
                    <div class="flex flex-col items-center text-center p-sm bg-surface-container-low rounded-xl">
                        <span class="material-symbols-outlined text-primary text-2xl mb-xs">laptop_mac</span>
                        <p class="text-[11px] font-semibold text-on-surface">Workspace</p>
                    </div>
                    <div class="flex flex-col items-center text-center p-sm bg-surface-container-low rounded-xl">
                        <span class="material-symbols-outlined text-primary text-2xl mb-xs">local_bar</span>
                        <p class="text-[11px] font-semibold text-on-surface">Mini-bar</p>
                    </div>
                    <div class="flex flex-col items-center text-center p-sm bg-surface-container-low rounded-xl">
                        <span class="material-symbols-outlined text-primary text-2xl mb-xs">room_service</span>
                        <p class="text-[11px] font-semibold text-on-surface">24/7 Service</p>
                    </div>
                </div>

                <div class="flex flex-wrap gap-xs" id="modalFeaturePills"></div>

                <div class="bg-surface-container p-sm rounded-xl flex items-start gap-sm border border-outline-variant/20">
                    <span class="material-symbols-outlined text-on-surface-variant text-[18px] shrink-0">info</span>
                    <p class="text-body-sm text-on-surface-variant">Free cancellation up to 48 hours before check-in.</p>
                </div>
            </div>

            <div class="w-full md:w-[340px] shrink-0 space-y-md">

                <div class="bg-primary text-white p-lg rounded-xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-2xl -mr-16 -mt-16 pointer-events-none"></div>
                    <div class="relative z-10">
                        <div class="flex justify-between items-center mb-sm">
                            <span class="text-xs bg-white/20 px-sm py-1 rounded-lg uppercase tracking-wider font-bold">AI-Recommended Rate</span>
                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings:'FILL' 1">auto_awesome</span>
                        </div>
                        <div class="flex items-baseline gap-xs">
                            <span class="text-3xl font-bold" id="modalPriceDisplay">—</span>
                            <span class="text-body-sm opacity-80">/ night</span>
                        </div>
                        <div class="mt-sm space-y-xs text-body-sm opacity-90">
                            <div class="flex justify-between"><span>Base Rate</span><span id="modalBaseRate">—</span></div>
                            <div class="flex justify-between"><span>Service Tax (12%)</span><span id="modalTaxAmount">—</span></div>
                            <div class="flex justify-between"><span>Tourism Levy</span><span id="modalLevyAmount">—</span></div>
                            <div class="border-t border-white/20 pt-xs flex justify-between font-bold">
                                <span>Total</span><span id="modalTotalAmount">—</span>
                            </div>
                        </div>
                    </div>
                </div>

                <form class="space-y-md bg-surface-container-lowest p-lg rounded-xl border border-outline-variant/20"
                      id="modalBookingForm" onsubmit="submitModalBooking(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalRoomId" name="roomId" />

                    <div>
                        <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs uppercase tracking-wide">Guest Name</label>
                        <input class="booking-input w-full bg-background border border-outline-variant rounded-lg px-md py-sm text-body-md"
                               type="text" id="modalGuestName" name="guestName" placeholder="Johnathan Doe" required />
                    </div>

                    <div>
                        <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs uppercase tracking-wide">Email Address</label>
                        <input class="booking-input w-full bg-background border border-outline-variant rounded-lg px-md py-sm text-body-md"
                               type="email" id="modalGuestEmail" name="guestEmail" placeholder="you@example.com" required />
                        <p class="text-label-sm text-on-surface-variant mt-xs">Used to find your bookings later. No account needed.</p>
                    </div>

                    <div class="grid grid-cols-2 gap-sm">
                        <div>
                            <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs uppercase tracking-wide">Check-in</label>
                            <input class="booking-input w-full bg-background border border-outline-variant rounded-lg px-sm py-sm text-body-md"
                                   type="date" id="modalCheckIn" name="checkIn" required />
                        </div>
                        <div>
                            <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs uppercase tracking-wide">Check-out</label>
                            <input class="booking-input w-full bg-background border border-outline-variant rounded-lg px-sm py-sm text-body-md"
                                   type="date" id="modalCheckOut" name="checkOut" required />
                        </div>
                    </div>

                    <div id="modalNightsSummary" class="hidden bg-primary/5 border border-primary/20 rounded-lg px-md py-sm flex items-center justify-between">
                        <span class="text-body-sm text-on-surface-variant" id="modalNightsLabel"></span>
                        <span class="font-bold text-primary text-label-md" id="modalNightsTotal"></span>
                    </div>

                    <div>
                        <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs uppercase tracking-wide">Guests</label>
                        <div class="flex items-center border border-outline-variant rounded-lg overflow-hidden">
                            <button type="button" onclick="changeModalGuests(-1)"
                                    class="px-md py-sm text-on-surface-variant hover:bg-surface-container transition-colors font-bold text-lg w-12 text-center">−</button>
                            <span id="modalGuestCount" class="flex-1 text-center font-bold text-on-surface text-body-md py-sm">2</span>
                            <button type="button" onclick="changeModalGuests(1)"
                                    class="px-md py-sm text-on-surface-variant hover:bg-surface-container transition-colors font-bold text-lg w-12 text-center">+</button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs uppercase tracking-wide">Payment</label>
                        <div class="space-y-xs">
                            <label class="flex items-center gap-sm p-sm border border-outline-variant rounded-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                                <input class="accent-primary h-4 w-4" name="modalPayment" type="radio" value="cc" checked />
                                <span class="material-symbols-outlined text-on-surface-variant text-[18px]">credit_card</span>
                                <span class="text-body-sm">Credit Card</span>
                            </label>
                            <label class="flex items-center gap-sm p-sm border border-outline-variant rounded-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                                <input class="accent-primary h-4 w-4" name="modalPayment" type="radio" value="cash" />
                                <span class="material-symbols-outlined text-on-surface-variant text-[18px]">payments</span>
                                <span class="text-body-sm">Cash</span>
                            </label>
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full bg-primary text-white py-md rounded-xl font-headline-sm
                                   hover:opacity-90 active:scale-95 transition-all shadow-md
                                   flex items-center justify-center gap-sm">
                        <span class="material-symbols-outlined text-[20px]">check_circle</span>
                        Confirm Booking
                    </button>
                    <p class="text-center text-label-sm text-on-surface-variant">Instant confirmation available</p>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="bookingSuccess">
    <div class="success-card bg-surface-container-lowest rounded-2xl shadow-2xl p-xl max-w-md w-full
                mx-gutter text-center border border-outline-variant/20">
        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-lg">
            <span class="material-symbols-outlined text-green-600 text-[44px]"
                  style="font-variation-settings:'FILL' 1">check_circle</span>
        </div>
        <h2 class="font-headline-md text-headline-md text-primary mb-sm">Booking Confirmed!</h2>
        <p class="text-body-md text-on-surface-variant mb-xs">Your reservation has been placed successfully.</p>
        <p class="text-label-sm text-on-surface-variant mb-xl" id="modalSuccessSummary"></p>
        <div class="flex gap-md">
            <a asp-controller="Booking" asp-action="MyBookings"
               class="flex-1 bg-primary text-on-primary py-md rounded-xl font-label-md text-center
                      hover:bg-primary-container transition-colors">
                View My Bookings
            </a>
            <button type="button" onclick="closeSuccess()"
                    class="flex-1 border border-outline-variant text-on-surface py-md rounded-xl
                           font-label-md hover:bg-surface-container transition-colors">
                Browse More
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterRooms(type, btn) {
        document.querySelectorAll('.room-tab').forEach(t => {
            t.classList.remove('text-primary','border-primary');
            t.classList.add('text-on-surface-variant','border-transparent');
        });
        btn.classList.remove('text-on-surface-variant','border-transparent');
        btn.classList.add('text-primary','border-primary');
        document.querySelectorAll('.room-card').forEach(card => {
            const matchType  = type === 'All Rooms' || card.dataset.type === type;
            const matchAvail = type !== 'Available'  || card.dataset.status === 'Available';
            card.style.display = (matchType && matchAvail) ? 'flex' : 'none';
        });
    }

    document.getElementById('searchInput')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.room-card').forEach(card => {
            const name = card.querySelector('h3')?.textContent.toLowerCase() ?? '';
            card.style.display = name.includes(q) ? 'flex' : 'none';
        });
    });

    function toggleSave(btn) {
        const icon = btn.querySelector('.material-symbols-outlined');
        const card = btn.closest('.room-card');
        const room = {
            id:    card.dataset.roomId,
            name:  card.querySelector('h3').textContent.trim(),
            floor: card.querySelector('.room-floor').textContent.trim(),
            price: parseFloat(card.dataset.price),
            image: card.querySelector('img').src
        };
        let saved = JSON.parse(sessionStorage.getItem('swm_saved_rooms') || '[]');
        if (icon.textContent.trim() === 'favorite_border') {
            icon.textContent = 'favorite';
            icon.style.color = '#e53935';
            icon.style.fontVariationSettings = "'FILL' 1";
            if (!saved.find(r => r.id === room.id)) {
                saved.push(room);
                sessionStorage.setItem('swm_saved_rooms', JSON.stringify(saved));
            }
        } else {
            icon.textContent = 'favorite_border';
            icon.style.color = '';
            icon.style.fontVariationSettings = "'FILL' 0";
            saved = saved.filter(r => r.id !== room.id);
            sessionStorage.setItem('swm_saved_rooms', JSON.stringify(saved));
        }
    }

    // Slide 1 is the room's own card image; slides 2-4 are shared sample shots
    const modalSlides = [
        "/images/rooms/BookingSampleImage/BookingSample1.avif",
        "/images/rooms/BookingSampleImage/BookingSample2.avif",
        "/images/rooms/BookingSampleImage/BookingSample3.avif"
    ];
    let modalCurrentSlide = 0;
    let modalBasePrice = 250;
    let modalGuests = 2;

    function openBookingModal(card) {
        const name      = card.dataset.name;
        const floor     = card.dataset.floor;
        const roomId    = card.dataset.roomId;
        const price     = parseFloat(card.dataset.price);
        const base      = parseInt(card.dataset.base);
        const typeLabel = card.dataset.typeLabel;
        const imgSrc    = card.querySelector('img').src;

        modalBasePrice = base;

        document.getElementById('modalRoomName').textContent      = name;
        document.getElementById('modalRoomFloor').textContent     = floor;
        document.getElementById('modalRoomId').value              = roomId;
        document.getElementById('modalPriceDisplay').textContent  = '$' + price.toFixed(0);
        document.getElementById('modalRoomTypeBadge').textContent = typeLabel;

        const slides = [imgSrc, ...modalSlides];
        modalCurrentSlide = 0;
        document.getElementById('modalCarouselImg').src = slides[0];

        const thumbsEl = document.getElementById('modalThumbs');
        thumbsEl.innerHTML = slides.map((src, i) =>
            `<div class="modal-thumb ${i === 0 ? 'active' : 'border border-outline-variant/30'}"
                  onclick="goToModalSlide(${i}, this, ${JSON.stringify(slides).replace(/"/g, '&quot;')})">
                <img class="w-full h-full object-cover" src="${src}" alt="View ${i+1}" />
            </div>`
        ).join('');

        const pillsByType = {
            'Business Suite': ['Work Desk', 'City View', 'Smart Lighting'],
            'Standard':       ['King Bed', 'Smart TV', 'Marble Bath'],
            'Deluxe Suite':   ['Ocean View', 'King Bed', 'Balcony'],
            'Family Suite':   ['Sleeps 4', 'Kitchenette', 'Bathtub']
        };
        const pills = pillsByType[typeLabel] || ['Free WiFi', 'AC', 'Smart TV'];
        document.getElementById('modalFeaturePills').innerHTML = pills.map(p =>
            `<span class="feature-pill"><span class="material-symbols-outlined text-[12px] text-primary">check_circle</span> ${p}</span>`
        ).join('');

        const fmt = d => d.toISOString().split('T')[0];
        const today = new Date(), tmr = new Date();
        tmr.setDate(today.getDate() + 1);
        document.getElementById('modalCheckIn').value  = fmt(today);
        document.getElementById('modalCheckOut').value = fmt(tmr);
        document.getElementById('modalGuestCount').textContent = '2';
        modalGuests = 2;
        recalcModalPrice();

        document.getElementById('bookingModal').classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeBookingModal() {
        document.getElementById('bookingModal').classList.remove('show');
        document.body.style.overflow = '';
    }

    function handleModalBackdropClick(e) {
        if (e.target === document.getElementById('bookingModal')) closeBookingModal();
    }

    function goToModalSlide(i, thumbEl, slides) {
        modalCurrentSlide = i;
        document.getElementById('modalCarouselImg').style.opacity = '0';
        setTimeout(() => {
            document.getElementById('modalCarouselImg').src = slides[i];
            document.getElementById('modalCarouselImg').style.opacity = '1';
        }, 150);
        document.querySelectorAll('.modal-thumb').forEach((t, idx) => {
            t.classList.toggle('active', idx === i);
        });
    }

    function modalNextSlide() {
        const thumbs = document.querySelectorAll('.modal-thumb');
        modalCurrentSlide = (modalCurrentSlide + 1) % thumbs.length;
        thumbs[modalCurrentSlide]?.click();
    }
    function modalPrevSlide() {
        const thumbs = document.querySelectorAll('.modal-thumb');
        modalCurrentSlide = (modalCurrentSlide - 1 + thumbs.length) % thumbs.length;
        thumbs[modalCurrentSlide]?.click();
    }

    function changeModalGuests(d) {
        modalGuests = Math.max(1, Math.min(10, modalGuests + d));
        document.getElementById('modalGuestCount').textContent = modalGuests;
    }

    function recalcModalPrice() {
        const ci = document.getElementById('modalCheckIn').value;
        const co = document.getElementById('modalCheckOut').value;
        const summary = document.getElementById('modalNightsSummary');
        if (!ci || !co) { summary.classList.add('hidden'); return; }
        const nights = Math.round((new Date(co) - new Date(ci)) / 86400000);
        if (nights <= 0) { summary.classList.add('hidden'); return; }
        const base  = modalBasePrice * nights;
        const tax   = +(base * 0.12).toFixed(2);
        const levy  = 5 * nights;
        const total = base + tax + levy;
        document.getElementById('modalNightsLabel').textContent  = nights + ' night' + (nights !== 1 ? 's' : '');
        document.getElementById('modalNightsTotal').textContent  = '$' + total.toFixed(2);
        document.getElementById('modalBaseRate').textContent     = '$' + base.toFixed(2);
        document.getElementById('modalTaxAmount').textContent    = '$' + tax.toFixed(2);
        document.getElementById('modalLevyAmount').textContent   = '$' + levy.toFixed(2);
        document.getElementById('modalTotalAmount').textContent  = '$' + total.toFixed(2);
        summary.classList.remove('hidden');
    }

    document.getElementById('modalCheckIn').addEventListener('change',  recalcModalPrice);
    document.getElementById('modalCheckOut').addEventListener('change', recalcModalPrice);

    async function submitModalBooking(e) {
        e.preventDefault();
        const form  = e.target;
        const name  = document.getElementById('modalGuestName').value.trim();
        const email = document.getElementById('modalGuestEmail').value.trim();
        const ci    = document.getElementById('modalCheckIn').value;
        const co    = document.getElementById('modalCheckOut').value;
        if (!name || !email || !ci || !co) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalLabel = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span> Processing...';

        const payment = form.querySelector('input[name="modalPayment"]:checked').value;

        try {
            const res = await fetch('/Room/Book', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    roomId: document.getElementById('modalRoomId').value,
                    guestName: name,
                    guestEmail: email,
                    checkIn: ci,
                    checkOut: co,
                    paymentMethod: payment
                })
            });

            if (!res.ok) throw new Error('Booking failed');
            const data = await res.json();

            const fmt = d => new Date(d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
            document.getElementById('modalSuccessSummary').textContent =
                name + ' · ' + fmt(ci) + ' → ' + fmt(co) +
                ' (' + data.nights + ' night' + (data.nights !== 1 ? 's' : '') + ') · Total $' + data.total;

            closeBookingModal();
            document.getElementById('bookingSuccess').classList.add('show');
        } catch (err) {
            alert('Something went wrong while booking. Please try again.');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalLabel;
        }
    }

    function closeSuccess() {
        document.getElementById('bookingSuccess').classList.remove('show');
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeBookingModal();
            closeSuccess();
        }
    });
</script>
}
