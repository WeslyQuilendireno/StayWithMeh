                    </div>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-primary mb-sm">Deluxe Ocean View</h3>
                <div class="flex flex-wrap gap-md mb-lg">
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">king_bed</span>
                        <span class="text-body-sm">King Bed</span>
                    </div>
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">waves</span>
                        <span class="text-body-sm">Ocean View</span>
                    </div>
                    <div class="flex items-center gap-1 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">balcony</span>
                        <span class="text-body-sm">Balcony</span>
                    </div>
