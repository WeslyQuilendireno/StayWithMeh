                                <input class="accent-primary h-4 w-4" name="modalPayment" type="radio" value="cc" checked />
                                <span class="material-symbols-outlined text-on-surface-variant text-[18px]">credit_card</span>
                                <span class="text-body-sm">Credit Card</span>
                            </label>
                            <label class="flex items-center gap-sm p-sm border border-outline-variant rounded-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                                <input class="accent-primary h-4 w-4" name="modalPayment" type="radio" value="cash" />
                                <span class="material-symbols-outlined text-on-surface-variant text-[18px]">payments</span>
                                <span class="text-body-sm">Cash</span>
