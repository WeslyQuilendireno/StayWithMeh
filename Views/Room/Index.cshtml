    <!-- ═══ PAGINATION ═══ -->
    <div class="mt-xl flex justify-between items-center bg-surface-container-lowest p-md
                rounded-xl shadow-sm border border-outline-variant/20">
        <p class="text-body-sm text-on-surface-variant">
            Showing <span class="font-bold text-on-surface">6</span> of
