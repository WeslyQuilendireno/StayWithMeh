@section Scripts {
<script>
    // ── Tab filter ──
    function filterRooms(type, btn) {
        document.querySelectorAll('.room-tab').forEach(t => {
            t.classList.remove('text-primary','border-primary');
            t.classList.add('text-on-surface-variant','border-transparent');
        });
        btn.classList.remove('text-on-surface-variant','border-transparent');
        btn.classList.add('text-primary','border-primary');
        document.querySelectorAll('.room-card').forEach(card => {
            const matchType  = type === 'All Rooms' || card.dataset.type === type;
            const matchAvail = type !== 'Available'  || card.dataset.status === 'Available';
            card.style.display = (matchType && matchAvail) ? 'flex' : 'none';
        });
    }

    // ── Search filter ──
    document.getElementById('searchInput')?.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.room-card').forEach(card => {
            const name = card.querySelector('h3')?.textContent.toLowerCase() ?? '';
            card.style.display = name.includes(q) ? 'flex' : 'none';
        });
    });

    // ── Wishlist toggle ──
    function toggleSave(btn) {
        const icon = btn.querySelector('.material-symbols-outlined');
        const card = btn.closest('.room-card');
        const room = {
            id:    card.dataset.roomId,
            name:  card.querySelector('h3').textContent.trim(),
            floor: card.querySelector('.room-floor').textContent.trim(),
            price: parseFloat(card.dataset.price),
            image: card.querySelector('img').src
        };
        let saved = JSON.parse(sessionStorage.getItem('swm_saved_rooms') || '[]');
        if (icon.textContent.trim() === 'favorite_border') {
            icon.textContent = 'favorite';
            icon.style.color = '#e53935';
            icon.style.fontVariationSettings = "'FILL' 1";
            if (!saved.find(r => r.id === room.id)) {
                saved.push(room);
                sessionStorage.setItem('swm_saved_rooms', JSON.stringify(saved));
            }
        } else {
            icon.textContent = 'favorite_border';
            icon.style.color = '';
            icon.style.fontVariationSettings = "'FILL' 0";
            saved = saved.filter(r => r.id !== room.id);
            sessionStorage.setItem('swm_saved_rooms', JSON.stringify(saved));
        }
    }

    // ══════════════════════════════════════════════
    // BOOKING MODAL
    // ══════════════════════════════════════════════
 
    const modalSlides = [
        "/images/rooms/BookingSampleImage/BookingSample1.avif",
        "/images/rooms/BookingSampleImage/BookingSample2.avif",
        "/images/rooms/BookingSampleImage/BookingSample3.avif"
    ];
    let modalCurrentSlide = 0;
    let modalBasePrice = 250;
    let modalGuests = 2;

    function openBookingModal(card) {
        // Populate from card data attributes
        const name = card.dataset.name;
        const floor = card.dataset.floor;
        const roomId = card.dataset.roomId;
        const price = parseFloat(card.dataset.price);
        const base = parseInt(card.dataset.base);
        const typeLabel = card.dataset.typeLabel;
        const imgSrc = card.querySelector('img').src;

        modalBasePrice = base;

        document.getElementById('modalRoomName').textContent = name;
        document.getElementById('modalRoomFloor').textContent = floor;
        document.getElementById('modalRoomId').value = roomId;
        document.getElementById('modalPriceDisplay').textContent = '$' + price.toFixed(0);
        document.getElementById('modalRoomTypeBadge').textContent = typeLabel;

        // Slide 1 = room's own card image, slides 2-4 = booking sample images
        const slides = [imgSrc, ...modalSlides];
        modalCurrentSlide = 0;
        document.getElementById('modalCarouselImg').src = slides[0];

        // Build thumbnails
        const thumbsEl = document.getElementById('modalThumbs');
        thumbsEl.innerHTML = slides.map((src, i) =>
            `<div class="modal-thumb ${i === 0 ? 'active' : 'border border-outline-variant/30'}"
                  onclick="goToModalSlide(${i}, this, ${JSON.stringify(slides).replace(/"/g, '&quot;')})">
                <img class="w-full h-full object-cover" src="${src}" alt="View ${i+1}" />
            </div>`
        ).join('');

        // Set default dates
        const fmt = d => d.toISOString().split('T')[0];
        const today = new Date(), tmr = new Date();
        tmr.setDate(today.getDate() + 1);
        document.getElementById('modalCheckIn').value = fmt(today);
        document.getElementById('modalCheckOut').value = fmt(tmr);
        document.getElementById('modalGuestCount').textContent = '2';
        modalGuests = 2;
        recalcModalPrice();

        document.getElementById('bookingModal').classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeBookingModal() {
        document.getElementById('bookingModal').classList.remove('show');
        document.body.style.overflow = '';
    }

    function handleModalBackdropClick(e) {
        if (e.target === document.getElementById('bookingModal')) closeBookingModal();
    }

    // ── Modal carousel ──
    function goToModalSlide(i, thumbEl, slides) {
        modalCurrentSlide = i;
        document.getElementById('modalCarouselImg').style.opacity = '0';
        setTimeout(() => {
            document.getElementById('modalCarouselImg').src = slides[i];
            document.getElementById('modalCarouselImg').style.opacity = '1';
        }, 150);
        document.querySelectorAll('.modal-thumb').forEach((t, idx) => {
            t.classList.toggle('active', idx === i);
        });
    }

    function modalNextSlide() {
        const thumbs = document.querySelectorAll('.modal-thumb');
        modalCurrentSlide = (modalCurrentSlide + 1) % thumbs.length;
        thumbs[modalCurrentSlide]?.click();
    }
    function modalPrevSlide() {
        const thumbs = document.querySelectorAll('.modal-thumb');
        modalCurrentSlide = (modalCurrentSlide - 1 + thumbs.length) % thumbs.length;
        thumbs[modalCurrentSlide]?.click();
    }

    // ── Modal guests ──
    function changeModalGuests(d) {
        modalGuests = Math.max(1, Math.min(10, modalGuests + d));
        document.getElementById('modalGuestCount').textContent = modalGuests;
    }

    // ── Modal price recalc ──
    function recalcModalPrice() {
        const ci = document.getElementById('modalCheckIn').value;
        const co = document.getElementById('modalCheckOut').value;
        const summary = document.getElementById('modalNightsSummary');
        if (!ci || !co) { summary.classList.add('hidden'); return; }
        const nights = Math.round((new Date(co) - new Date(ci)) / 86400000);
        if (nights <= 0) { summary.classList.add('hidden'); return; }
        const base = modalBasePrice * nights;
        const tax = +(base * 0.12).toFixed(2);
        const levy = 5 * nights;
        const total = base + tax + levy;
        document.getElementById('modalNightsLabel').textContent = nights + ' night' + (nights !== 1 ? 's' : '');
        document.getElementById('modalNightsTotal').textContent = '$' + total.toFixed(2);
        document.getElementById('modalBaseRate').textContent = '$' + base.toFixed(2);
        document.getElementById('modalTaxAmount').textContent = '$' + tax.toFixed(2);
        document.getElementById('modalLevyAmount').textContent = '$' + levy.toFixed(2);
        document.getElementById('modalTotalAmount').textContent = '$' + total.toFixed(2);
        summary.classList.remove('hidden');
    }

    document.getElementById('modalCheckIn').addEventListener('change', recalcModalPrice);
    document.getElementById('modalCheckOut').addEventListener('change', recalcModalPrice);

    // ── Modal submit ──
    function submitModalBooking(e) {
        e.preventDefault();
        const name = document.getElementById('modalGuestName').value.trim();
        const ci = document.getElementById('modalCheckIn').value;
        const co = document.getElementById('modalCheckOut').value;
        if (!name || !ci || !co) return;
        const nights = Math.round((new Date(co) - new Date(ci)) / 86400000);
        const fmt = d => new Date(d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
        document.getElementById('modalSuccessSummary').textContent =
            name + ' · ' + fmt(ci) + ' → ' + fmt(co) +
            ' (' + nights + ' night' + (nights !== 1 ? 's' : '') + ')';
        closeBookingModal();
        document.getElementById('bookingSuccess').classList.add('show');
    }

    function closeSuccess() {
        document.getElementById('bookingSuccess').classList.remove('show');
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeBookingModal();
            closeSuccess();
        }
    });
</script>
}
