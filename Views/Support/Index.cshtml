                            <p>1. Connect to: <strong class="text-primary">StayWithMeh_Guest</strong></p>
                            <p>2. Enter your room number + last name in the browser</p>
                            <p>3. Issues? Dial <strong>extension 0</strong> or visit the front desk</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Support Requests Empty -->
        <div class="mt-8">
            <h2 class="font-headline-lg text-headline-lg text-primary mb-6">Your Support Requests</h2>
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm">
