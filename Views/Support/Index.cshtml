@{
    ViewData["Title"] = "Support";
    ViewData["ActivePage"] = "Support";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease-out;
    }
    .accordion-item.active .accordion-content { max-height: 600px; }
    .accordion-item.active .arrow-icon { transform: rotate(180deg); }
    .arrow-icon { transition: transform 0.3s ease; }

    .empty-state {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 56px 24px; text-align: center;
    }
    .empty-icon-wrap {
        width: 72px; height: 72px; border-radius: 50%;
        background: #efedf0;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 20px;
    }

    #swm-dd {
        position: fixed !important;
        z-index: 99999 !important;
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 14px;
        box-shadow: 0 24px 64px rgba(0,0,0,0.28);
        overflow-y: auto;
        max-height: 340px;
        min-width: 280px;
        display: none;
    }
    #swm-dd .dd-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 20px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        color: #1b1b1e;
        white-space: nowrap;
        font-family: 'Inter', sans-serif;
    }
    #swm-dd .dd-row:hover { background: #f5f3f6; }
    #swm-dd .dd-icon {
        font-family: 'Material Symbols Outlined';
        font-size: 20px;
        color: #031635;
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        flex-shrink: 0;
    }
</style>

<section class="bg-primary py-16 px-gutter">
    <div class="max-w-[1440px] mx-auto text-center">
        <h1 class="text-white font-display-lg text-display-lg mb-md">How can we help you?</h1>
        <p class="text-white/80 font-body-lg text-body-lg max-w-2xl mx-auto mb-xl">
            Search our knowledge base or browse common topics below to find quick solutions for your stay.
        </p>

        <div class="max-w-2xl mx-auto">
            <div class="flex items-center bg-white rounded-xl shadow-lg">
                <button id="concern-toggle" type="button"
                        onclick="ddToggle(event)"
                        class="flex items-center gap-1 pl-4 pr-3 py-4 border-r border-gray-200
                               text-sm font-semibold text-primary whitespace-nowrap
                               hover:bg-gray-50 transition-colors shrink-0 rounded-l-xl">
                    <span class="material-symbols-outlined text-[18px]" id="concern-icon">help_center</span>
                    <span id="concern-label">All Topics</span>
                    <span class="material-symbols-outlined text-[16px]" id="concern-arrow"
                          style="transition:transform .3s">expand_more</span>
                </button>
                <input id="support-search"
                       class="flex-1 border-none focus:ring-0 text-base text-on-surface px-4 py-4 bg-transparent"
                       placeholder="Describe your issue (e.g. 'How to cancel a booking')"
                       type="text" />
                <button type="button"
                        class="mr-2 px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold
                               hover:bg-primary-container transition-colors shrink-0">
                    Search
                </button>
            </div>
        </div>

        <div class="flex flex-wrap justify-center gap-2 mt-6">
            <button onclick="ddQuick('Cancellations & Refunds','event_busy')"
                    class="bg-white/15 text-white border border-white/30 px-4 py-1 rounded-full text-xs font-semibold hover:bg-white/25 transition-colors">
                Cancel Booking
            </button>
            <button onclick="ddQuick('Check-in Policies','key')"
                    class="bg-white/15 text-white border border-white/30 px-4 py-1 rounded-full text-xs font-semibold hover:bg-white/25 transition-colors">
                Check-in Time
            </button>
            <button onclick="ddQuick('Payments & Billing','payments')"
                    class="bg-white/15 text-white border border-white/30 px-4 py-1 rounded-full text-xs font-semibold hover:bg-white/25 transition-colors">
                Refund Status
            </button>
            <button onclick="ddQuick('Wi-Fi & Technical','wifi')"
                    class="bg-white/15 text-white border border-white/30 px-4 py-1 rounded-full text-xs font-semibold hover:bg-white/25 transition-colors">
                Wi-Fi Issues
            </button>
            <button onclick="ddQuick('Payments & Billing','payments')"
                    class="bg-white/15 text-white border border-white/30 px-4 py-1 rounded-full text-xs font-semibold hover:bg-white/25 transition-colors">
                Payment Issues
            </button>
        </div>
    </div>
</section>

<div class="max-w-[1440px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-6 mt-8 pb-8">

    <div class="lg:col-span-8 space-y-6">
        <h2 class="font-headline-lg text-headline-lg text-primary">Frequently Asked Questions</h2>

        <div class="space-y-3">

            <div class="accordion-item active bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
                <button type="button" onclick="toggleAccordion(this)"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-surface-container-low transition-colors">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">event_busy</span>
                        <span class="font-headline-sm text-headline-sm">Cancellations &amp; Refunds</span>
                    </div>
                    <span class="material-symbols-outlined arrow-icon text-outline">expand_more</span>
                </button>
                <div class="accordion-content border-t border-outline-variant/20">
                    <div class="p-6 space-y-4">
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Guests may cancel most bookings up to <strong class="text-on-surface">24 hours prior to the scheduled check-in date</strong>
                            to receive a full refund. Refund amounts are credited back to the original payment method within
                            <strong class="text-on-surface">5 to 7 business days</strong>, subject to your financial institution's processing schedule.
                        </p>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Reservations booked under a non-refundable rate are not eligible for a refund under any standard circumstance.
                            Guests who believe their situation warrants an exception — such as a documented medical emergency or force majeure —
                            are encouraged to submit a formal request through our support channels for individual review.
                            All cancellation requests must be submitted through your Bookings dashboard or by contacting our support team directly.
                        </p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="bg-green-50 border border-green-200 rounded-xl p-4">
                                <p class="font-bold text-sm text-green-800 mb-1">Full Refund Eligible</p>
                                <p class="text-sm text-green-700">Cancellation submitted more than 24 hours before check-in on a flexible rate booking.</p>
                            </div>
                            <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                                <p class="font-bold text-sm text-red-800 mb-1">Non-Refundable</p>
                                <p class="text-sm text-red-700">Bookings made under a non-refundable rate, or cancellations submitted within 24 hours of check-in.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
                <button type="button" onclick="toggleAccordion(this)"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-surface-container-low transition-colors">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">key</span>
                        <span class="font-headline-sm text-headline-sm">Check-in Policies</span>
                    </div>
                    <span class="material-symbols-outlined arrow-icon text-outline">expand_more</span>
                </button>
                <div class="accordion-content border-t border-outline-variant/20">
                    <div class="p-6 space-y-4">
                        <div class="grid grid-cols-3 gap-4 text-center">
                            <div class="bg-surface-container p-4 rounded-xl">
                                <span class="material-symbols-outlined text-primary text-[28px] mb-1 block">login</span>
                                <p class="font-bold text-sm">Check-in</p>
                                <p class="font-headline-sm text-headline-sm text-primary">3:00 PM</p>
                            </div>
                            <div class="bg-surface-container p-4 rounded-xl">
                                <span class="material-symbols-outlined text-primary text-[28px] mb-1 block">logout</span>
                                <p class="font-bold text-sm">Check-out</p>
                                <p class="font-headline-sm text-headline-sm text-primary">12:00 PM</p>
                            </div>
                            <div class="bg-surface-container p-4 rounded-xl">
                                <span class="material-symbols-outlined text-primary text-[28px] mb-1 block">smartphone</span>
                                <p class="font-bold text-sm">Online</p>
                                <p class="font-headline-sm text-headline-sm text-primary">24 hrs</p>
                            </div>
                        </div>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Standard check-in begins at <strong class="text-on-surface">3:00 PM</strong> and check-out is required by
                            <strong class="text-on-surface">12:00 PM (noon)</strong>. Early check-in may be accommodated subject to room
                            availability and may incur an additional fee at the property's discretion.
                        </p>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            All guests are required to present a <strong class="text-on-surface">valid government-issued photo identification</strong>
                            and the <strong class="text-on-surface">original credit or debit card</strong> used at the time of booking upon arrival at the front desk.
                            Failure to provide the required documentation may result in denial of check-in without eligibility for a refund.
                            Requests for late check-out must be made no later than 9:00 AM on the day of departure.
                        </p>
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
                <button type="button" onclick="toggleAccordion(this)"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-surface-container-low transition-colors">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">payments</span>
                        <span class="font-headline-sm text-headline-sm">Payments &amp; Billing</span>
                    </div>
                    <span class="material-symbols-outlined arrow-icon text-outline">expand_more</span>
                </button>
                <div class="accordion-content border-t border-outline-variant/20">
                    <div class="p-6 space-y-4">
                        <div class="grid grid-cols-3 gap-4 text-center">
                            <div class="bg-surface-container p-4 rounded-xl">
                                <span class="material-symbols-outlined text-primary text-[28px] mb-1 block">credit_card</span>
                                <p class="font-bold text-xs">Credit / Debit</p>
                                <p class="text-sm text-on-surface-variant">Visa, MC, Amex</p>
                            </div>
                            <div class="bg-surface-container p-4 rounded-xl">
                                <span class="material-symbols-outlined text-primary text-[28px] mb-1 block">payments</span>
                                <p class="font-bold text-xs">Cash</p>
                                <p class="text-sm text-on-surface-variant">Front desk only</p>
                            </div>
                            <div class="bg-surface-container p-4 rounded-xl">
                                <span class="material-symbols-outlined text-primary text-[28px] mb-1 block">receipt_long</span>
                                <p class="font-bold text-xs">Bank Transfer</p>
                                <p class="text-sm text-on-surface-variant">Corporate only</p>
                            </div>
                        </div>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            StayWithMeh accepts all major credit and debit cards including Visa, Mastercard, and American Express,
                            as well as cash payments processed at the front desk. Full payment is collected at the time of booking confirmation.
                            An official receipt is automatically issued to your registered email address upon successful payment.
                        </p>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Guests requiring corporate billing arrangements or official invoices for reimbursement purposes should contact
                            our finance support team with their booking reference number and company details prior to their stay.
                        </p>
                        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
                            <p class="font-bold text-sm text-amber-800 mb-1 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">info</span> Security Deposit
                            </p>
                            <p class="text-sm text-amber-700">
                                A temporary hold of <strong>$150 to $300</strong> is placed on the payment card at check-in and
                                released within <strong>3 to 5 business days</strong> following checkout, subject to no damage or outstanding charges.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
                <button type="button" onclick="toggleAccordion(this)"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-surface-container-low transition-colors">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">wifi</span>
                        <span class="font-headline-sm text-headline-sm">Wi-Fi &amp; Technical</span>
                    </div>
                    <span class="material-symbols-outlined arrow-icon text-outline">expand_more</span>
                </button>
                <div class="accordion-content border-t border-outline-variant/20">
                    <div class="p-6 space-y-4">
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Complimentary high-speed wireless internet access is available throughout the property at speeds of up to
                            <strong class="text-on-surface">300 Mbps</strong>, provided at no additional charge to all registered guests.
                            The network is secured and monitored to ensure a reliable and private connection during your stay.
                        </p>
                        <div class="bg-surface-container rounded-xl p-4 text-sm text-on-surface-variant space-y-2">
                            <p class="font-bold text-sm text-on-surface mb-1">Connection Instructions</p>
                            <p>1. Select the network: <strong class="text-primary">StayWithMeh_Guest</strong></p>
                            <p>2. Open a browser and enter your room number along with your last name when prompted.</p>
                            <p>3. Should you encounter any connectivity issues, please dial <strong>extension 0</strong> from your in-room telephone or visit the front desk.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
                <button type="button" onclick="toggleAccordion(this)"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-surface-container-low transition-colors">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">bed</span>
                        <span class="font-headline-sm text-headline-sm">Room &amp; Amenities</span>
                    </div>
                    <span class="material-symbols-outlined arrow-icon text-outline">expand_more</span>
                </button>
                <div class="accordion-content border-t border-outline-variant/20">
                    <div class="p-6 space-y-4">
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            All guest rooms are serviced daily between <strong class="text-on-surface">9:00 AM and 3:00 PM</strong>.
                            Should you prefer not to be disturbed, please display the Do Not Disturb sign on your door and our housekeeping team
                            will schedule your service at a more convenient time upon request.
                        </p>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Additional amenities including extra pillows, towels, toiletries, or room service may be requested at any time
                            by contacting the front desk or dialing <strong class="text-on-surface">extension 1</strong> from your in-room telephone.
                            Our team is available around the clock to assist with any in-room requirements.
                        </p>
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm overflow-hidden">
                <button type="button" onclick="toggleAccordion(this)"
                        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-surface-container-low transition-colors">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">edit_calendar</span>
                        <span class="font-headline-sm text-headline-sm">Booking Modifications</span>
                    </div>
                    <span class="material-symbols-outlined arrow-icon text-outline">expand_more</span>
                </button>
                <div class="accordion-content border-t border-outline-variant/20">
                    <div class="p-6 space-y-4">
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            Modifications to existing reservations — including changes to check-in or check-out dates, room type, or number of guests —
                            may be requested through your Bookings dashboard or by contacting our support team directly.
                        </p>
                        <p class="text-body-md text-on-surface-variant leading-relaxed">
                            All modification requests are subject to room availability at the time of the request and may result in a rate adjustment
                            based on the prevailing pricing at the time of change. Modifications to non-refundable bookings may be limited and are
                            reviewed on a case-by-case basis.
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <div class="mt-8">
            <h2 class="font-headline-lg text-headline-lg text-primary mb-6">Your Support Requests</h2>
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm">
                <div class="empty-state">
                    <div class="empty-icon-wrap">
                        <span class="material-symbols-outlined text-outline" style="font-size:36px">inbox</span>
                    </div>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-1">No support requests yet</h3>
                    <p class="text-sm text-on-surface-variant max-w-sm">
                        You haven't submitted any support requests. Use Live Chat or Email Support if you need help.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="lg:col-span-4 space-y-6">
        <h2 class="font-headline-lg text-headline-lg text-primary">Need more help?</h2>

        <div class="bg-primary text-on-primary p-6 rounded-xl shadow-lg">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-[28px]">chat</span>
                </div>
                <div>
                    <h4 class="font-headline-sm text-headline-sm">Live Chat</h4>
                    <p class="text-xs opacity-80">Wait time: &lt; 2 mins</p>
                </div>
            </div>
            <p class="text-sm mb-6 opacity-90">Chat with support agents in real-time for immediate assistance.</p>
            <button class="w-full py-4 bg-white text-primary font-bold rounded-lg hover:bg-surface-container transition-colors">
                Start Conversation
            </button>
        </div>

        <div class="bg-surface-container-lowest border border-outline-variant p-6 rounded-xl shadow-sm">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 bg-surface-container-high rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-[28px]">mail</span>
                </div>
                <div>
                    <h4 class="font-headline-sm text-headline-sm text-on-surface">Email Support</h4>
                    <p class="text-xs text-on-surface-variant">Response in 24 hours</p>
                </div>
            </div>
            <p class="text-sm text-on-surface-variant mb-6">For complex inquiries or formal requests.</p>
            <button class="w-full py-4 border-2 border-primary text-primary font-bold rounded-lg hover:bg-primary/5 transition-colors">
                Submit a Ticket
            </button>
        </div>

        <div class="rounded-xl overflow-hidden relative h-48 group">
            <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                 src="~/images/customer_support_center/CustomerSupport.png" alt="StayWithMeh Care Agent" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-4">
                <p class="text-white text-xs opacity-80">StayWithMeh Care</p>
                <h5 class="text-white font-headline-sm">24/7 Global Assistance</h5>
            </div>
        </div>

        <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl shadow-sm p-6 space-y-4">
            <h3 class="font-headline-sm text-headline-sm text-primary">Direct Contact</h3>
            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">call</span>
                <div>
                    <p class="font-bold text-sm text-on-surface">Phone</p>
                    <p class="text-sm text-on-surface-variant">+1 (800) 789-STAY</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">mail</span>
                <div>
                    <p class="font-bold text-sm text-on-surface">Email</p>
                    <p class="text-sm text-on-surface-variant">support&#64;staywithmeh.com</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="material-symbols-outlined text-primary bg-primary/10 p-2 rounded-lg">schedule</span>
                <div>
                    <p class="font-bold text-sm text-on-surface">Hours</p>
                    <p class="text-sm text-on-surface-variant">24 hours, 7 days a week</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var DD_OPTIONS = [
    { label: 'All Topics', icon: 'help_center' },
    { label: 'Cancellations & Refunds', icon: 'event_busy' },
    { label: 'Check-in Policies', icon: 'key' },
    { label: 'Payments & Billing', icon: 'payments' },
    { label: 'Room & Amenities', icon: 'bed' },
    { label: 'Wi-Fi & Technical', icon: 'wifi' },
    { label: 'Booking Modifications', icon: 'edit_calendar'},
    { label: 'Other Concerns', icon: 'support_agent'}
];

var _dd = (function() {
    var el = document.createElement('div');
    el.id = 'swm-dd';

    DD_OPTIONS.forEach(function(opt) {
        var row = document.createElement('div');
        row.className = 'dd-row';

        var icon = document.createElement('span');
        icon.className = 'dd-icon material-symbols-outlined';
        icon.textContent = opt.icon;

        row.appendChild(icon);
        row.appendChild(document.createTextNode(opt.label));
        row.addEventListener('click', function(e) {
            e.stopPropagation();
            ddSelect(opt.label, opt.icon);
        });
        el.appendChild(row);
    });

    el.style.display = 'none';
    return el;
})();

function ddPosition() {
    var toggle = document.getElementById('concern-toggle');
    if (!toggle) return;
    var r = toggle.getBoundingClientRect();
    _dd.style.top  = (r.bottom + 6) + 'px';
    _dd.style.left = r.left + 'px';
}

function ddOpen() {
    document.body.appendChild(_dd);
    ddPosition();
    _dd.style.display = 'block';
    document.getElementById('concern-arrow').style.transform = 'rotate(180deg)';
}

function ddClose() {
    _dd.style.display = 'none';
    var arrow = document.getElementById('concern-arrow');
    if (arrow) arrow.style.transform = 'rotate(0deg)';
}

function ddToggle(e) {
    e.stopPropagation();
    _dd.style.display === 'none' ? ddOpen() : ddClose();
}

function ddSelect(label, icon) {
    document.getElementById('concern-label').textContent = label;
    document.getElementById('concern-icon').textContent  = icon;
    ddClose();
    document.getElementById('support-search').focus();
}

function ddQuick(label, icon) {
    document.getElementById('concern-label').textContent = label;
    document.getElementById('concern-icon').textContent  = icon;
    document.getElementById('support-search').focus();
}

document.addEventListener('click', function(e) {
    if (_dd.style.display === 'none') return;
    var toggle = document.getElementById('concern-toggle');
    if (toggle && toggle.contains(e.target)) return;
    if (_dd.contains(e.target)) return;
    ddClose();
});

window.addEventListener('scroll', function() {
    if (_dd.style.display !== 'none') ddPosition();
}, { passive: true });

window.addEventListener('resize', function() {
    if (_dd.style.display !== 'none') ddPosition();
});

function toggleAccordion(btn) {
    var item     = btn.closest('.accordion-item');
    var isActive = item.classList.contains('active');
    document.querySelectorAll('.accordion-item').forEach(function(i) {
        i.classList.remove('active');
    });
    if (!isActive) item.classList.add('active');
}
</script>
}
