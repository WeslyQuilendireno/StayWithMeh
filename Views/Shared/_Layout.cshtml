<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayWithMeh</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-container": "#efedf0",
                        "on-surface": "#1b1b1e",
                        "surface-bright": "#fbf8fc",
                        "on-primary": "#ffffff",
                        "surface-container-low": "#f5f3f6",
                        "secondary": "#5d5e61",
                        "on-surface-variant": "#44474e",
                        "surface-container-highest": "#e4e2e5",
                        "secondary-container": "#dfdfe2",
                        "secondary-fixed": "#e2e2e5",
                        "on-secondary-fixed": "#1a1c1e",
                        "outline-variant": "#c5c6cf",
                        "primary-container": "#1a2b4b",
                        "background": "#fbf8fc",
                        "surface-container-lowest": "#ffffff",
                        "outline": "#75777f",
                        "primary": "#031635",
                        "surface-container-high": "#e9e7eb",
                        "surface": "#fbf8fc",
                        "error": "#ba1a1a"
                    },
                    spacing: {
                        "lg": "24px", "xs": "4px", "gutter": "24px",
                        "sm": "8px", "md": "16px", "xl": "32px",
                        "container-max": "1440px"
                    },
                    fontSize: {
                        "label-sm": ["12px", { lineHeight: "16px", fontWeight: "600" }],
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "body-sm": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "label-md": ["14px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "500" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "600" }],
                        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "600" }]
                    }
                }
            }
        }
    </script>

    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* ── Sliding nav underline ── */
        .nav-slider {
            position: absolute;
            bottom: 0;
            height: 2px;
            background: #031635;
            border-radius: 2px;
            transition: left 0.35s cubic-bezier(.4,0,.2,1),
                        width 0.35s cubic-bezier(.4,0,.2,1);
            pointer-events: none;
        }
        .nav-link {
            position: relative;
            transition: color 0.2s;
        }
    </style>
</head>
<body class="bg-background text-on-surface">

<!-- ═══════════════════════════════ NAVBAR ═══════════════════════════════ -->
<header id="main-header"
        class="fixed top-0 left-0 w-full z-50 bg-white border-b border-outline-variant h-16 transition-all duration-300">
    <div class="h-full max-w-[1440px] mx-auto px-10 flex justify-between items-center">

        <!-- Logo -->
        <a asp-controller="Home" asp-action="Index"
           class="text-2xl font-black text-primary tracking-tight shrink-0">StayWithMeh</a>

        <!-- Nav Links with sliding underline -->
        <nav class="hidden lg:flex items-center gap-6 relative h-full" id="mainNav">

            <span class="nav-slider" id="navSlider"></span>

            <!-- Home -->
            <a asp-controller="Home" asp-action="Index"
               class="nav-link text-sm font-medium h-full flex items-center
                      @(ViewData["ActivePage"]?.ToString() == "Home" ? "text-primary font-bold" : "text-on-surface-variant hover:text-primary")"
               data-nav="Home">Home</a>

            <!-- Explore -->
            <a asp-controller="Explore" asp-action="Index"
               class="nav-link text-sm font-medium h-full flex items-center
                      @(ViewData["ActivePage"]?.ToString() == "Explore" ? "text-primary font-bold" : "text-on-surface-variant hover:text-primary")"
               data-nav="Explore">Explore</a>

            <!-- Bookings -->
            <a asp-controller="Booking" asp-action="MyBookings"
               class="nav-link text-sm font-medium h-full flex items-center
                      @(ViewData["ActivePage"]?.ToString() == "Bookings" ? "text-primary font-bold" : "text-on-surface-variant hover:text-primary")"
               data-nav="Bookings">Bookings</a>

            <!-- Rooms -->
            <a asp-controller="Room" asp-action="Index"
               class="nav-link text-sm font-medium h-full flex items-center
                      @(ViewData["ActivePage"]?.ToString() == "Rooms" ? "text-primary font-bold" : "text-on-surface-variant hover:text-primary")"
               data-nav="Rooms">Rooms</a>

            <!-- Saved -->
            <a asp-controller="Wishlist" asp-action="Index"
               class="nav-link text-sm font-medium h-full flex items-center
                      @(ViewData["ActivePage"]?.ToString() == "Saved" ? "text-primary font-bold" : "text-on-surface-variant hover:text-primary")"
               data-nav="Saved">Saved</a>

            <!-- Support -->
            <a asp-controller="Support" asp-action="Index"
               class="nav-link text-sm font-medium h-full flex items-center
                      @(ViewData["ActivePage"]?.ToString() == "Support" ? "text-primary font-bold" : "text-on-surface-variant hover:text-primary")"
               data-nav="Support">Support</a>
        </nav>

        <!-- Right Actions -->
        <div class="flex items-center gap-4">
            <div class="relative hidden xl:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-primary text-xl">search</span>
                <input type="text" placeholder="Search bookings..."
                       class="bg-surface-container border-none rounded-lg pl-10 pr-4 py-2 text-sm w-56
                              focus:ring-0 placeholder:text-outline" />
            </div>
            <a asp-controller="Booking" asp-action="MyBookings"
               class="bg-primary text-white px-4 py-2 rounded-lg font-bold text-sm flex items-center
                      gap-1 hover:bg-primary-container transition-colors">
                <span class="material-symbols-outlined text-lg">add</span> Add Booking
            </a>
            <div class="flex items-center gap-2">
                <button class="material-symbols-outlined text-primary hover:bg-surface-container
                               rounded-full p-1.5 transition-colors">notifications</button>
                <button class="material-symbols-outlined text-primary hover:bg-surface-container
                               rounded-full p-1.5 transition-colors">settings</button>
                <div class="w-9 h-9 rounded-lg bg-surface-container border border-outline-variant
                            flex items-center justify-center ml-1 cursor-pointer">
                    <span class="material-symbols-outlined text-primary">person</span>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Page Content -->
<main class="pt-16">
    @RenderBody()
</main>

<!-- ═══════════════════════════════ FOOTER ═══════════════════════════════ -->
<footer class="bg-primary text-white pt-xl pb-lg px-lg mt-xl">
    <div class="max-w-[1440px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-xl mb-xl">
            <div class="flex flex-col gap-md">
                <span class="text-2xl font-black">StayWithMeh</span>
                <p class="text-body-sm opacity-60">The operating system for modern hospitality.
                    Seamless management for hotels, effortless stays for guests.</p>
                <div class="flex gap-md mt-sm">
                    <span class="material-symbols-outlined cursor-pointer opacity-60 hover:opacity-100">language</span>
                    <span class="material-symbols-outlined cursor-pointer opacity-60 hover:opacity-100">share</span>
                    <span class="material-symbols-outlined cursor-pointer opacity-60 hover:opacity-100">public</span>
                </div>
            </div>
            <div class="flex flex-col gap-md">
                <span class="text-label-md font-label-md uppercase tracking-widest opacity-40">Destinations</span>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">New York, USA</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">London, UK</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Tokyo, Japan</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Dubai, UAE</a>
            </div>
            <div class="flex flex-col gap-md">
                <span class="text-label-md font-label-md uppercase tracking-widest opacity-40">Company</span>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">About Us</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Careers</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Sustainability</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Newsroom</a>
            </div>
            <div class="flex flex-col gap-md">
                <span class="text-label-md font-label-md uppercase tracking-widest opacity-40">Support</span>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Help Center</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">My Booking</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Contact Us</a>
                <a class="text-body-sm hover:translate-x-1 transition-transform" href="#">Terms of Service</a>
            </div>
        </div>
        <div class="pt-lg border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-md">
            <p class="text-label-sm opacity-40">© 2026 StayWithMeh. All rights reserved.</p>
            <div class="flex gap-lg text-label-sm opacity-40">
                <a href="#">Privacy Policy</a>
                <a href="#">Cookie Policy</a>
                <a href="#">Security</a>
            </div>
        </div>
    </div>
</footer>

<script>
    // ── Header scroll shadow ──
    window.addEventListener('scroll', () => {
        const h = document.getElementById('main-header');
        window.scrollY > 50
            ? h.classList.add('shadow-md')
            : h.classList.remove('shadow-md');
    });

    // ── Sliding nav underline ──
    (function () {
        const nav    = document.getElementById('mainNav');
        const slider = document.getElementById('navSlider');
        if (!nav || !slider) return;

        const activePage = "@ViewData["ActivePage"]";
        const links = nav.querySelectorAll('.nav-link');

        function moveSliderTo(el) {
            const navRect  = nav.getBoundingClientRect();
            const linkRect = el.getBoundingClientRect();
            slider.style.left  = (linkRect.left - navRect.left) + 'px';
            slider.style.width = linkRect.width + 'px';
        }

        links.forEach(link => {
            if (link.dataset.nav === activePage) {
                slider.style.transition = 'none';
                moveSliderTo(link);
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        slider.style.transition = '';
                    });
                });
            }
        });

        links.forEach(link => {
            link.addEventListener('mouseenter', () => moveSliderTo(link));
        });

        nav.addEventListener('mouseleave', () => {
            links.forEach(link => {
                if (link.dataset.nav === activePage) moveSliderTo(link);
            });
        });
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
