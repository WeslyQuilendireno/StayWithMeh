@model StayWithMeh.Models.ManagerDashboardViewModel
@{
    ViewData["Title"]          = "Manager Analytics";
    ViewData["ActiveStaffPage"] = "Analytics";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="grid grid-cols-12 gap-lg">

    <!--
        AI Pricing Insight has no real pricing engine behind it yet —
        the Python/FastAPI service is planned but not built. Shown as
        a clearly labeled preview of where that feature will surface.
    -->
    <div class="col-span-12 lg:col-span-4 bg-primary text-on-primary p-lg rounded-2xl flex flex-col">
        <div class="flex items-center gap-xs mb-md">
            <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
            <span class="text-label-sm font-bold uppercase tracking-widest opacity-80">AI Pricing Insight</span>
        </div>
        <h3 class="text-headline-md font-headline-md flex-1">Prices optimized for upcoming peak season</h3>
        <p class="text-body-sm opacity-70 mt-md">
            Preview only — the dynamic pricing engine is still in development.
        </p>
        <div class="flex items-end justify-between mt-lg">
            <div>
                <p class="text-display-lg font-bold">+12.4%</p>
                <p class="text-label-sm opacity-60">Projected RevPAR</p>
            </div>
            <button disabled class="bg-on-primary/20 text-on-primary px-lg py-sm rounded-xl text-label-md font-bold opacity-50 cursor-not-allowed">
                Apply All
            </button>
        </div>
    </div>

    <!-- Occupancy snapshot — real data, shown as today's value rather than a fabricated weekly trend -->
    <div class="col-span-12 lg:col-span-8 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
        <h3 class="text-headline-sm font-headline-sm text-primary mb-md">Today's Occupancy Snapshot</h3>
        <div class="flex items-end gap-xl">
            <div>
                <p class="text-display-lg font-bold text-primary">@Model.OccupancyPercent%</p>
                <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Current Occupancy</p>
            </div>
            <div class="flex-1 grid grid-cols-4 gap-md">
                <div class="bg-surface-container rounded-xl p-md text-center">
                    <p class="text-headline-sm font-bold text-on-surface">@Model.AvailableCount</p>
                    <p class="text-label-sm text-on-surface-variant">Available</p>
                </div>
                <div class="bg-surface-container rounded-xl p-md text-center">
                    <p class="text-headline-sm font-bold text-on-surface">@Model.OccupiedCount</p>
                    <p class="text-label-sm text-on-surface-variant">Occupied</p>
                </div>
                <div class="bg-surface-container rounded-xl p-md text-center">
                    <p class="text-headline-sm font-bold text-on-surface">@Model.DirtyCount</p>
                    <p class="text-label-sm text-on-surface-variant">Dirty</p>
                </div>
                <div class="bg-surface-container rounded-xl p-md text-center">
                    <p class="text-headline-sm font-bold text-on-surface">@Model.MaintenanceCount</p>
                    <p class="text-label-sm text-on-surface-variant">Maintenance</p>
                </div>
            </div>
        </div>
        <p class="text-body-sm text-on-surface-variant mt-md">
            A historical trend chart needs daily occupancy snapshots over time, which aren't tracked yet —
            this card shows the real current state instead of a fabricated weekly line.
        </p>
    </div>

    <!-- Revenue by Room Type -->
    <div class="col-span-12 lg:col-span-6 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
        <h3 class="text-headline-sm font-headline-sm text-primary mb-lg">Revenue by Room Type</h3>
        @{
            var revenueByType = Model.Bookings
                .Join(Model.Rooms, b => b.RoomId, r => r.Id, (b, r) => new { r.RoomType, b.TotalAmount })
                .GroupBy(x => x.RoomType)
                .Select(g => new { RoomType = g.Key, Total = g.Sum(x => x.TotalAmount) })
                .OrderByDescending(x => x.Total)
                .ToList();

            var maxRevenue = revenueByType.Any() ? revenueByType.Max(x => x.Total) : 1;
        }
        @if (!revenueByType.Any())
        {
            <p class="text-body-sm text-on-surface-variant text-center py-lg">No completed bookings yet.</p>
        }
        else
        {
            <div class="space-y-md">
                @foreach (var item in revenueByType)
                {
                    var widthPct = maxRevenue > 0 ? (int)(item.Total / maxRevenue * 100) : 0;
                    <div>
                        <div class="flex justify-between mb-xs">
                            <span class="text-label-md font-bold text-on-surface">@item.RoomType</span>
                            <span class="text-label-md font-bold text-primary">$@item.Total.ToString("N0")</span>
                        </div>
                        <div class="h-2 bg-surface-container rounded-full overflow-hidden">
                            <div class="h-full bg-primary rounded-full" style="width: @(widthPct)%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Staff Management table -->
    <div class="col-span-12 lg:col-span-6 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
        <h3 class="text-headline-sm font-headline-sm text-primary mb-lg">Staff Management</h3>
        <table class="w-full text-left">
            <thead>
                <tr class="text-label-sm text-on-surface-variant uppercase tracking-widest border-b border-outline-variant/20">
                    <th class="pb-sm">Employee</th>
                    <th class="pb-sm">Department</th>
                    <th class="pb-sm">Shift</th>
                    <th class="pb-sm">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shift in Model.Shifts)
                {
                    var (badgeBg, badgeText) = shift.Status switch
                    {
                        "active"  => ("bg-green-100", "text-green-800"),
                        "pending" => ("bg-amber-100", "text-amber-800"),
                        _         => ("bg-surface-container", "text-on-surface-variant")
                    };

                    <tr class="border-b border-outline-variant/10 last:border-0">
                        <td class="py-md text-label-md font-bold text-on-surface">@shift.StaffName</td>
                        <td class="py-md text-body-sm text-on-surface-variant">@shift.Department</td>
                        <td class="py-md text-body-sm text-on-surface-variant">
                            @shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm")
                        </td>
                        <td class="py-md">
                            <span class="px-md py-xs rounded-full text-label-sm font-bold capitalize @badgeBg @badgeText">
                                @shift.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Bottom stat strip -->
    <div class="col-span-12 grid grid-cols-2 md:grid-cols-4 gap-md">
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
            <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Rooms Dirty</p>
            <p class="text-headline-lg font-headline-lg text-primary mt-xs">@Model.DirtyCount</p>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
            <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Check-ins Today</p>
            <p class="text-headline-lg font-headline-lg text-primary mt-xs">@Model.TodayCheckInsCount</p>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg opacity-60">
            <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Guest Satisfaction</p>
            <p class="text-headline-lg font-headline-lg text-on-surface-variant mt-xs">—</p>
            <p class="text-[10px] text-on-surface-variant">No review system yet</p>
        </div>
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 p-lg">
            <p class="text-label-sm text-on-surface-variant uppercase tracking-widest">Net Revenue</p>
            <p class="text-headline-lg font-headline-lg text-primary mt-xs">$@Model.Bookings.Sum(b => b.TotalAmount).ToString("N0")</p>
        </div>
    </div>

</div>
