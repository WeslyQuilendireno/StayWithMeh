            </div>
        </div>
        <div class="flex gap-4">
            <div class="text-center">
                <p class="font-bold text-primary text-headline-md">98%</p>
                <p class="text-[10px] uppercase font-bold text-outline">Satisfaction</p>
            </div>
            <div class="w-px h-10 bg-outline-variant"></div>
            <div class="text-center">
                <p class="font-bold text-primary text-headline-md">24/7</p>
                <p class="text-[10px] uppercase font-bold text-outline">Support</p>
            </div>
