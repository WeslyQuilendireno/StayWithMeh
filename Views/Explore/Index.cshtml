                        <button class="p-2.5 rounded-full border border-outline-variant hover:bg-surface-container transition-colors">
                            <span class="material-symbols-outlined">info</span>
                        </button>
                        <a asp-controller="Room" asp-action="Details" asp-route-id="1"
                           class="bg-primary text-on-primary px-6 py-2.5 rounded-full font-label-md
