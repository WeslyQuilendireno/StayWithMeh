@section Scripts {
<script>
    // ── Price slider ──
    document.getElementById('priceRange')?.addEventListener('input', function () {
        document.getElementById('priceDisplay').textContent = '$' + this.value;
    });

    // ── Grid / List toggle ──
    document.getElementById('gridBtn')?.addEventListener('click', function () {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg';
    });
    document.getElementById('listBtn')?.addEventListener('click', function () {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 gap-lg';
    });

    // ══════════════════════════════════════════════
    // CAROUSEL — pure translateX infinite wrap
    // window.onload ensures Tailwind CDN is done
    // ══════════════════════════════════════════════
    window.addEventListener('load', function () {
        var track   = document.getElementById('carouselTrack');
        var btnPrev = document.getElementById('btnPrev');
        var btnNext = document.getElementById('btnNext');
        if (!track || !btnPrev || !btnNext) return;

        var CARD_W    = 300;
        var GAP       = 24;
        var STEP      = CARD_W + GAP;   // 324px per card
        var total     = track.querySelectorAll('.dest-card').length; // 8
        var VISIBLE   = 4;              // always show exactly 4 at start
        var maxIndex  = total - VISIBLE;
        var current   = 0;
        var animating = false;

        // Set initial position
        track.style.transform = 'translateX(0px)';

        // Size the viewport to show exactly 4 cards
        var viewportEl = track.parentElement;
        viewportEl.style.width = (VISIBLE * CARD_W + (VISIBLE - 1) * GAP) + 'px';
        viewportEl.style.maxWidth = '100%';

        function move(dir) {
            if (animating) return;
            animating = true;

            current += dir;
            if (current > maxIndex) current = 0;
            if (current < 0)        current = maxIndex;

            track.style.transform = 'translateX(-' + (current * STEP) + 'px)';
            setTimeout(function () { animating = false; }, 450);
        }

        btnNext.addEventListener('click', function () { move(1);  });
        btnPrev.addEventListener('click', function () { move(-1); });
    });

    // ── Branch filter ──
    var activeCity = null;

    document.querySelectorAll('.dest-card').forEach(function (card) {
        card.addEventListener('click', function () {
            filterByCity(card.dataset.city);
        });
    });

    function filterByCity(city) {
        if (activeCity === city) { clearBranchFilter(); return; }
        activeCity = city;

        document.querySelectorAll('.dest-card').forEach(function (c) {
            if (c.dataset.city === city) {
                c.classList.add('active-branch');
                c.classList.remove('inactive-branch');
            } else {
                c.classList.remove('active-branch');
                c.classList.add('inactive-branch');
            }
        });

        document.getElementById('destinationInput').value = city;
        document.getElementById('activeBranchName').textContent = city;
        document.getElementById('activeBranchBar').classList.remove('hidden');
    }

    function clearBranchFilter() {
        activeCity = null;
        document.querySelectorAll('.dest-card').forEach(function (c) {
            c.classList.remove('active-branch', 'inactive-branch');
        });
        document.getElementById('destinationInput').value = '';
        document.getElementById('activeBranchBar').classList.add('hidden');
    }
</script>
}
