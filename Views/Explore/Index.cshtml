</section>

@section Scripts {
<script>
    // Price range
    const pr = document.getElementById('priceRange');
    const pd = document.getElementById('priceDisplay');
    pr?.addEventListener('input', () => pd.textContent = '$' + pr.value);

    // Destination scroll
    const sc = document.getElementById('destinationScroll');
    document.getElementById('scrollLeft')?.addEventListener('click',  () => sc.scrollBy({ left: -300, behavior: 'smooth' }));
    document.getElementById('scrollRight')?.addEventListener('click', () => sc.scrollBy({ left:  300, behavior: 'smooth' }));

    // Grid / List toggle
    document.getElementById('gridBtn')?.addEventListener('click', () => {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg';
    });
    document.getElementById('listBtn')?.addEventListener('click', () => {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 gap-lg';
    });
</script>
}
