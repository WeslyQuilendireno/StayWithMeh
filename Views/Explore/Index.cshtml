        <div>
            <h2 class="font-headline-lg text-headline-lg text-primary">Popular Destinations</h2>
            <p class="text-on-surface-variant font-body-sm mt-xs">Curated trips based on your preferences</p>
        </div>
        <div class="flex gap-2">
