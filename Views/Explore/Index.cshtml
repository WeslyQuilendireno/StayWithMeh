                    overflow-hidden flex flex-col group hover:shadow-md hover:-translate-y-1 transition-all">
            <div class="relative h-64 overflow-hidden">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                     src="~/images/explore_page/SkylineExecutiveSuite.png" alt="Skyline Executive Suite"
                     onerror="this.src='~/images/guest_landing_page_image/DeluxeSuite.png'" />
                <div class="absolute top-4 left-4 bg-primary text-on-primary px-3 py-1 rounded-full
