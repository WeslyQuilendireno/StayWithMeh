            <div class="relative h-64 overflow-hidden">
                <img class="w-full h-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105"
                     src="~/images/explore_page/AvailableRooms_GrandFamilyLoft.png" alt="Grand Family Loft" />
                <div class="absolute top-4 left-4 bg-outline text-surface px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider">Family</div>
                <div class="absolute top-4 right-4 bg-red-100 text-red-800 px-3 py-1 rounded-full text-label-sm font-bold">Fully Booked</div>
