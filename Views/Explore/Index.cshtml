                    <div class="flex items-center gap-1.5 text-on-surface-variant"><span class="material-symbols-outlined text-sm">family_restroom</span><span class="text-label-sm">4 Guests</span></div>
                    <div class="flex items-center gap-1.5 text-on-surface-variant"><span class="material-symbols-outlined text-sm">kitchen</span><span class="text-label-sm">Kitchenette</span></div>
                </div>
                <div class="mt-auto pt-lg border-t border-outline-variant/30 flex justify-between items-end">
                    <div>
                        <p class="text-on-surface-variant text-[10px] uppercase font-bold tracking-widest mb-1">Per Night</p>
                        <span class="font-headline-md text-headline-md text-primary">$450</span>
                    </div>
                    <button class="bg-surface-container text-outline px-6 py-2.5 rounded-full font-label-md cursor-not-allowed">Join Waitlist</button>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- ═══ FLASH OFFER + STANDARDS ═══ -->
<section class="mt-xl px-gutter max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-lg">
