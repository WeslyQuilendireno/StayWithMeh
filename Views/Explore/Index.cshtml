                     src="~/images/explore_page/newyorkUS.jpg" alt="New York" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent
                            flex flex-col justify-end p-lg">
                    <h3 class="text-white font-headline-md text-headline-md">New York</h3>
                    <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">United States</p>
                </div>
            </div>
            <div class="flex justify-between items-center px-2">
                <span class="text-label-md font-semibold text-on-surface">1,240 Properties</span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
            </div>
        </div>

        @* ── London ── *@
        <div class="min-w-[260px] max-w-[260px] group cursor-pointer flex-shrink-0">
            <div class="relative h-[380px] rounded-[120px] overflow-hidden mb-4">
                <img class="w-full h-full object-cover object-center
                            transition-transform duration-500 group-hover:scale-110"
                     src="~/images/explore_page/londonUK.jpg" alt="London" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent
                            flex flex-col justify-end p-lg">
                    <h3 class="text-white font-headline-md text-headline-md">London</h3>
                    <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">United Kingdom</p>
                </div>
            </div>
            <div class="flex justify-between items-center px-2">
                <span class="text-label-md font-semibold text-on-surface">890 Properties</span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
            </div>
        </div>

        @* ── Tokyo ── *@
        <div class="min-w-[260px] max-w-[260px] group cursor-pointer flex-shrink-0">
            <div class="relative h-[380px] rounded-[120px] overflow-hidden mb-4">
                <img class="w-full h-full object-cover object-center
                            transition-transform duration-500 group-hover:scale-110"
                     src="~/images/explore_page/tokyoJP.jpg" alt="Tokyo" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent
                            flex flex-col justify-end p-lg">
                    <h3 class="text-white font-headline-md text-headline-md">Tokyo</h3>
                    <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">Japan</p>
                </div>
            </div>
            <div class="flex justify-between items-center px-2">
                <span class="text-label-md font-semibold text-on-surface">2,150 Properties</span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
            </div>
        </div>

        @* ── Dubai ── *@
        <div class="min-w-[260px] max-w-[260px] group cursor-pointer flex-shrink-0">
            <div class="relative h-[380px] rounded-[120px] overflow-hidden mb-4">
                <img class="w-full h-full object-cover object-center
                            transition-transform duration-500 group-hover:scale-110"
                     src="~/images/explore_page/dubaiUAE.jpg" alt="Dubai" />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent
                            flex flex-col justify-end p-lg">
                    <h3 class="text-white font-headline-md text-headline-md">Dubai</h3>
                    <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">United Arab Emirates</p>
                </div>
            </div>
            <div class="flex justify-between items-center px-2">
                <span class="text-label-md font-semibold text-on-surface">1,020 Properties</span>
                <span class="material-symbols-outlined text-primary group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
            </div>
        </div>

    </div>
</section>

<!-- ═══════════════════════════════════════════════
     AVAILABLE ROOMS
═══════════════════════════════════════════════ -->
<section class="mt-xl px-gutter max-w-[1440px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
        <h2 class="font-headline-lg text-headline-lg text-primary">Available Rooms</h2>
        <div class="flex items-center gap-4 w-full md:w-auto">
            <div class="relative flex-1 md:w-56">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">sort</span>
                <select class="w-full pl-10 pr-4 py-2.5 bg-surface-container rounded-xl
                               border border-outline-variant font-label-md focus:ring-primary">
                    <option>Recommended</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                    <option>Top Rated</option>
                </select>
            </div>
            <div class="flex border border-outline-variant rounded-xl overflow-hidden shrink-0">
                <button id="gridBtn" class="p-2.5 bg-primary text-on-primary">
                    <span class="material-symbols-outlined">grid_view</span>
                </button>
                <button id="listBtn" class="p-2.5 bg-surface text-on-surface hover:bg-surface-container">
                    <span class="material-symbols-outlined">view_list</span>
                </button>
            </div>
        </div>
    </div>

    <div id="roomsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">

        <!-- Skyline Executive Suite -->
