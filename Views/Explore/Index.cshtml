@model StayWithMeh.Models.ExploreViewModel
@{
    ViewData["Title"]      = "Explore Destinations & Rooms";
    ViewData["ActivePage"] = "Explore";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roomTypeIcons = new Dictionary<string, (string icon, string label)>
    {
        { "Business Suite", ("desk", "Work Desk") },
        { "Standard",       ("king_bed", "King Bed") },
        { "Deluxe Suite",   ("waves", "Ocean View") },
        { "Family Suite",   ("family_restroom", "Sleeps 4") }
    };
}

<style>
    #carouselTrack {
        display: flex;
        width: max-content;
        transition: transform 420ms cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform;
    }
    .dest-card {
        flex: 0 0 300px;
        width: 300px;
        margin-right: 24px;
        cursor: pointer;
    }
    .dest-card img {
        transition: transform 500ms ease;
    }
    .dest-card:hover img {
        transform: scale(1.05);
    }
    .ring {
        position: absolute;
        inset: 0;
        border-radius: 1rem;
        border: 3px solid #031635;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s;
    }
    .dest-card.active-branch .ring  { opacity: 1; }
    .dest-card.inactive-branch      { opacity: 0.45; transition: opacity 0.2s; }

    #btnPrev:disabled, #btnNext:disabled { opacity: 0.3; cursor: not-allowed; }
</style>

<section class="mt-lg px-gutter max-w-[1440px] mx-auto">
    <form asp-controller="Explore" asp-action="Index" method="get">
        <div class="bg-surface-container-lowest rounded-full shadow-md border border-outline-variant p-2
                    flex flex-col lg:flex-row items-stretch gap-xs">

            <div class="flex-1 flex items-center px-4 py-3 gap-3 border-b lg:border-b-0 lg:border-r border-outline-variant">
                <span class="material-symbols-outlined text-primary">location_on</span>
                <div class="flex flex-col w-full">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Destination</span>
                    <input id="destinationInput"
                           class="border-none p-0 focus:ring-0 text-body-md w-full bg-transparent placeholder-on-surface-variant"
                           placeholder="Enter city, area or property name"
                           type="text" name="destination" value="@ViewData["Destination"]" autocomplete="off" />
                </div>
            </div>

            <div class="flex-1 flex items-center px-4 py-3 gap-3 border-b lg:border-b-0 lg:border-r border-outline-variant">
                <span class="material-symbols-outlined text-primary">calendar_month</span>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Check-in</span>
                    <input type="date" name="checkIn" value="@ViewData["CheckIn"]"
                           class="border-none p-0 focus:ring-0 text-body-md font-medium bg-transparent" />
                </div>
                <span class="mx-2 text-outline">|</span>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Check-out</span>
                    <input type="date" name="checkOut" value="@ViewData["CheckOut"]"
                           class="border-none p-0 focus:ring-0 text-body-md font-medium bg-transparent" />
                </div>
            </div>

            <div class="flex-1 flex items-center px-4 py-3 gap-3">
                <span class="material-symbols-outlined text-primary">group</span>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Rooms &amp; Guests</span>
                    <span class="text-body-md font-medium">1 Room, 2 Guests</span>
                </div>
            </div>

            <button type="submit"
                    class="bg-primary text-on-primary px-10 py-4 rounded-full font-headline-sm
                           flex items-center justify-center gap-2 hover:scale-[1.02] transition-transform">
                Search <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>

        <div class="mt-md flex flex-wrap items-center gap-md">
            <div class="flex items-center gap-2 bg-surface-container rounded-lg px-3 py-1.5 border border-outline-variant">
                <span class="text-label-sm text-on-surface-variant uppercase">Type:</span>
                <select name="type" class="bg-transparent border-none text-label-md p-0 pr-6 focus:ring-0">
                    <option>All Types</option>
                    <option>Standard</option>
                    <option>Deluxe Suite</option>
                    <option>Business Suite</option>
                    <option>Family Suite</option>
                </select>
            </div>
            <div class="flex items-center gap-2 bg-surface-container rounded-lg px-3 py-1.5 border border-outline-variant">
                <span class="text-label-sm text-on-surface-variant uppercase">Price:</span>
                <input id="priceRange" class="w-32 accent-primary" type="range" min="50" max="1000" value="500" />
                <span id="priceDisplay" class="text-label-sm text-primary font-bold">$500</span>
            </div>
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input class="rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" name="wifi" />
                    <span class="text-label-md">WiFi</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input class="rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" name="pool" />
                    <span class="text-label-md">Pool</span>
                </label>
            </div>
        </div>
    </form>
</section>

<section class="mt-xl px-gutter max-w-[1440px] mx-auto">
    <div class="flex justify-between items-end mb-lg">
        <div>
            <h2 class="font-headline-lg text-headline-lg text-primary">Our 8 Global Branches</h2>
            <p class="text-on-surface-variant font-body-sm mt-xs">Click any branch to filter rooms by location</p>
        </div>
        <div class="flex gap-2">
            <button id="btnPrev"
                    class="w-10 h-10 rounded-full border border-outline-variant flex items-center
                           justify-center hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <button id="btnNext"
                    class="w-10 h-10 rounded-full border border-outline-variant flex items-center
                           justify-center hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>
    </div>

    <div class="overflow-hidden pb-6">
        <div id="carouselTrack">

            @foreach (var property in Model.Properties)
            {
                var roomCount = Model.Rooms.Count(r => r.PropertyId == property.Id);

                <div class="dest-card" data-city="@property.City" data-property-id="@property.Id">
                    <div class="relative h-[380px] rounded-2xl overflow-hidden mb-4 shadow-sm">
                        <img class="w-full h-full object-cover object-center"
                             src="@property.ImageUrl" alt="@property.City" />
                        <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/10 to-transparent flex flex-col justify-end p-6">
                            <h3 class="text-white font-headline-md text-headline-md">@property.City</h3>
                            <p class="text-white/70 text-[11px] font-bold uppercase tracking-widest mt-1">@property.Country @property.FlagEmoji</p>
                        </div>
                        <div class="ring"></div>
                    </div>
                    <div class="flex justify-between items-center px-1">
                        <span class="text-label-md font-semibold text-on-surface">@roomCount Room@(roomCount != 1 ? "s" : "")</span>
                        <span class="material-symbols-outlined text-primary">arrow_right_alt</span>
                    </div>
                </div>
            }

        </div>
    </div>

    <div id="activeBranchBar"
         class="hidden mt-xs flex items-center justify-between bg-primary/5
                border border-primary/20 rounded-xl px-lg py-sm">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-primary text-[18px]">location_on</span>
            <span class="text-body-sm text-on-surface">
                Showing rooms for <strong id="activeBranchName" class="text-primary"></strong>
            </span>
        </div>
        <button onclick="clearBranchFilter()"
                class="text-label-sm text-on-surface-variant hover:text-primary transition-colors flex items-center gap-xs">
            <span class="material-symbols-outlined text-[16px]">close</span> Clear filter
        </button>
    </div>
</section>

<section class="mt-xl px-gutter max-w-[1440px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
        <h2 class="font-headline-lg text-headline-lg text-primary">Available Rooms</h2>
        <div class="flex items-center gap-4 w-full md:w-auto">
            <div class="relative flex-1 md:w-56">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">sort</span>
                <select class="w-full pl-10 pr-4 py-2.5 bg-surface-container rounded-xl border border-outline-variant font-label-md focus:ring-primary">
                    <option>Recommended</option>
                    <option>Price: Low to High</option>
                    <option>Price: High to Low</option>
                    <option>Top Rated</option>
                </select>
            </div>
            <div class="flex border border-outline-variant rounded-xl overflow-hidden shrink-0">
                <button id="gridBtn" class="p-2.5 bg-primary text-on-primary">
                    <span class="material-symbols-outlined">grid_view</span>
                </button>
                <button id="listBtn" class="p-2.5 bg-surface text-on-surface hover:bg-surface-container">
                    <span class="material-symbols-outlined">view_list</span>
                </button>
            </div>
        </div>
    </div>

    <div id="roomsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">

        @foreach (var room in Model.Rooms)
        {
            var isAvailable = room.Status.Equals("available", StringComparison.OrdinalIgnoreCase);
            var icon  = roomTypeIcons.TryGetValue(room.RoomType, out var iv) ? iv.icon  : "bed";
            var label = roomTypeIcons.TryGetValue(room.RoomType, out var lv) ? lv.label : "Room";

            <div class="room-result-card bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-sm
                        overflow-hidden flex flex-col group hover:shadow-md @(isAvailable ? "hover:-translate-y-1" : "") transition-all"
                 data-property-id="@room.PropertyId">
                <div class="relative h-64 overflow-hidden">
                    <img class="w-full h-full object-cover @(isAvailable ? "" : "opacity-80") transition-transform duration-700 group-hover:scale-105"
                         src="@room.ImageUrl" alt="@room.RoomType" />
                    <div class="absolute top-4 left-4 bg-primary text-on-primary px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider">@room.RoomType</div>
                    <div class="absolute top-4 right-4">
                        @if (isAvailable)
                        {
                            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-label-sm font-bold flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Available
                            </span>
                        }
                        else
                        {
                            <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-label-sm font-bold">Unavailable</span>
                        }
                    </div>
                </div>
                <div class="p-lg flex-1 flex flex-col @(isAvailable ? "" : "opacity-80")">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="font-headline-sm text-headline-sm text-primary">@room.RoomType — Room @room.RoomNumber</h3>
                        <div class="flex items-center gap-1 text-primary">
                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings:'FILL' 1">star</span>
                            <span class="font-bold text-label-md">4.8</span>
                        </div>
                    </div>
                    <p class="text-on-surface-variant font-body-sm mb-lg">@room.Description</p>
                    <div class="flex gap-md mb-lg flex-wrap">
                        <div class="flex items-center gap-1.5 text-on-surface-variant">
                            <span class="material-symbols-outlined text-sm">@icon</span>
                            <span class="text-label-sm">@label</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-on-surface-variant">
                            <span class="material-symbols-outlined text-sm">wifi</span>
                            <span class="text-label-sm">Free WiFi</span>
                        </div>
                    </div>
                    <div class="mt-auto pt-lg border-t border-outline-variant/30 flex justify-between items-end">
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase font-bold tracking-widest mb-1">Per Night</p>
                            <span class="font-headline-md text-headline-md text-primary">$@room.PricePerNight.ToString("0.00")</span>
                        </div>
                        <div class="flex gap-2">
                            @if (isAvailable)
                            {
                                <a asp-controller="Room" asp-action="Details" asp-route-id="@room.Id"
                                   class="bg-primary text-on-primary px-6 py-2.5 rounded-full font-label-md hover:bg-primary-container transition-colors">Book Now</a>
                            }
                            else
                            {
                                <button class="bg-surface-container text-outline px-6 py-2.5 rounded-full font-label-md cursor-not-allowed">Join Waitlist</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div id="noRoomsMessage" class="hidden text-center py-xl">
        <span class="material-symbols-outlined text-outline text-[48px] mb-md block">hotel</span>
        <p class="font-headline-sm text-headline-sm text-on-surface mb-xs">No rooms available in this branch yet</p>
        <p class="text-body-sm text-on-surface-variant">Check back soon, or explore other branches.</p>
    </div>
</section>

<section class="mt-xl px-gutter max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-lg">
    <div class="bg-primary-container p-xl rounded-3xl relative overflow-hidden">
        <div class="relative z-10">
            <span class="bg-white/20 text-white px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest mb-4 inline-block">Flash Offer</span>
            <h2 class="font-headline-lg text-headline-lg text-white mb-4">Business Trip? Save 25%</h2>
            <p class="font-body-md text-white/90 mb-lg max-w-md">Unlock exclusive corporate rates and flexible cancellation policies for all midweek bookings in Q2.</p>
            <button class="bg-white text-primary px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform">Get Partner Code</button>
        </div>
        <span class="material-symbols-outlined absolute -bottom-10 -right-10 text-[200px] opacity-10 rotate-12 text-white">corporate_fare</span>
    </div>
    <div class="bg-surface-container p-xl rounded-3xl border border-outline-variant/30">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-lg">Operational Standards</h2>
        <div class="grid grid-cols-2 gap-md">
            <div class="flex items-start gap-3 p-4 bg-surface rounded-2xl">
                <span class="material-symbols-outlined text-primary bg-blue-50 p-2 rounded-lg">pool</span>
                <div><p class="font-bold text-label-md">Infinity Pool</p><p class="text-[10px] text-on-surface-variant uppercase">Temperature Controlled</p></div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-surface rounded-2xl">
                <span class="material-symbols-outlined text-primary bg-blue-50 p-2 rounded-lg">fitness_center</span>
                <div><p class="font-bold text-label-md">24/7 Gym</p><p class="text-[10px] text-on-surface-variant uppercase">TechnoGym Equipt</p></div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-surface rounded-2xl">
                <span class="material-symbols-outlined text-primary bg-blue-50 p-2 rounded-lg">restaurant</span>
                <div><p class="font-bold text-label-md">Gourmet Dining</p><p class="text-[10px] text-on-surface-variant uppercase">Michelin Rated</p></div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-surface rounded-2xl">
                <span class="material-symbols-outlined text-primary bg-blue-50 p-2 rounded-lg">local_laundry_service</span>
                <div><p class="font-bold text-label-md">Express Valet</p><p class="text-[10px] text-on-surface-variant uppercase">Same Day Return</p></div>
            </div>
        </div>
    </div>
</section>

<section class="px-gutter max-w-[1440px] mx-auto my-xl">
    <div class="bg-surface-container-high p-lg rounded-2xl flex flex-col md:flex-row items-center justify-between gap-lg">
        <div class="flex items-center gap-md">
            <div class="flex -space-x-3">
                <div class="w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold border-2 border-surface">WQ</div>
                <div class="w-12 h-12 rounded-full bg-primary-container text-white flex items-center justify-center font-bold border-2 border-surface">JD</div>
                <div class="w-12 h-12 rounded-full bg-secondary text-white flex items-center justify-center font-bold border-2 border-surface">SM</div>
                <div class="w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center text-[12px] font-bold border-2 border-surface">+12k</div>
            </div>
            <div>
                <p class="font-bold text-headline-sm text-primary">Trusted by over 50,000 travelers</p>
                <p class="text-on-surface-variant font-body-sm">Consistent 4.8/5 rating across all 8 global branches.</p>
            </div>
        </div>
        <div class="flex gap-4">
            <div class="text-center"><p class="font-bold text-primary text-headline-md">98%</p><p class="text-[10px] uppercase font-bold text-outline">Satisfaction</p></div>
            <div class="w-px h-10 bg-outline-variant"></div>
            <div class="text-center"><p class="font-bold text-primary text-headline-md">24/7</p><p class="text-[10px] uppercase font-bold text-outline">Support</p></div>
            <div class="w-px h-10 bg-outline-variant"></div>
            <div class="text-center"><p class="font-bold text-primary text-headline-md">8</p><p class="text-[10px] uppercase font-bold text-outline">Branches</p></div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    document.getElementById('priceRange')?.addEventListener('input', function () {
        document.getElementById('priceDisplay').textContent = '$' + this.value;
    });

    document.getElementById('gridBtn')?.addEventListener('click', function () {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg';
    });
    document.getElementById('listBtn')?.addEventListener('click', function () {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 gap-lg';
    });

    // window.onload ensures Tailwind CDN has finished layout before measuring card widths
    window.addEventListener('load', function () {
        var track   = document.getElementById('carouselTrack');
        var btnPrev = document.getElementById('btnPrev');
        var btnNext = document.getElementById('btnNext');
        if (!track || !btnPrev || !btnNext) return;

        var CARD_W   = 300;
        var GAP      = 24;
        var STEP     = CARD_W + GAP;
        var total    = track.querySelectorAll('.dest-card').length;
        var VISIBLE  = Math.min(4, total);
        var maxIndex = Math.max(0, total - VISIBLE);
        var current  = 0;
        var animating = false;

        track.style.transform = 'translateX(0px)';

        var viewportEl = track.parentElement;
        viewportEl.style.width = (VISIBLE * CARD_W + (VISIBLE - 1) * GAP) + 'px';
        viewportEl.style.maxWidth = '100%';

        function move(dir) {
            if (animating) return;
            animating = true;

            current += dir;
            if (current > maxIndex) current = 0;
            if (current < 0)        current = maxIndex;

            track.style.transform = 'translateX(-' + (current * STEP) + 'px)';
            setTimeout(function () { animating = false; }, 450);
        }

        btnNext.addEventListener('click', function () { move(1);  });
        btnPrev.addEventListener('click', function () { move(-1); });
    });

    var activeCity = null;
    var activePropertyId = null;

    document.querySelectorAll('.dest-card').forEach(function (card) {
        card.addEventListener('click', function () {
            filterByBranch(card.dataset.city, card.dataset.propertyId);
        });
    });

    function filterByBranch(city, propertyId) {
        if (activeCity === city) { clearBranchFilter(); return; }
        activeCity = city;
        activePropertyId = propertyId;

        document.querySelectorAll('.dest-card').forEach(function (c) {
            if (c.dataset.city === city) {
                c.classList.add('active-branch');
                c.classList.remove('inactive-branch');
            } else {
                c.classList.remove('active-branch');
                c.classList.add('inactive-branch');
            }
        });

        document.getElementById('destinationInput').value = city;
        document.getElementById('activeBranchName').textContent = city;
        document.getElementById('activeBranchBar').classList.remove('hidden');

        applyRoomFilter();
    }

    function clearBranchFilter() {
        activeCity = null;
        activePropertyId = null;
        document.querySelectorAll('.dest-card').forEach(function (c) {
            c.classList.remove('active-branch', 'inactive-branch');
        });
        document.getElementById('destinationInput').value = '';
        document.getElementById('activeBranchBar').classList.add('hidden');
        applyRoomFilter();
    }

    function applyRoomFilter() {
        var cards = document.querySelectorAll('.room-result-card');
        var visibleCount = 0;

        cards.forEach(function (card) {
            var matches = !activePropertyId || card.dataset.propertyId === activePropertyId;
            card.style.display = matches ? 'flex' : 'none';
            if (matches) visibleCount++;
        });

        document.getElementById('noRoomsMessage').classList.toggle('hidden', visibleCount > 0);
        document.getElementById('roomsGrid').classList.toggle('hidden', visibleCount === 0);
    }
</script>
}
