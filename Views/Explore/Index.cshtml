                           hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>
    </div>

    <div id="destinationScroll" class="flex gap-md overflow-x-auto no-scrollbar pb-4">

        @* ── New York ── *@
        <div class="min-w-[260px] max-w-[260px] group cursor-pointer flex-shrink-0">
            <div class="relative h-[380px] rounded-[120px] overflow-hidden mb-4">
