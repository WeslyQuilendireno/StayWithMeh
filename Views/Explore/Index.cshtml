@section Scripts {
<script>
    // ── Price range slider ──
    const pr = document.getElementById('priceRange');
    const pd = document.getElementById('priceDisplay');
    pr?.addEventListener('input', () => pd.textContent = '$' + pr.value);

    // ── Destination scroll buttons ──
    const sc = document.getElementById('destinationScroll');
    document.getElementById('scrollLeft')?.addEventListener('click',
        () => sc.scrollBy({ left: -300, behavior: 'smooth' }));
    document.getElementById('scrollRight')?.addEventListener('click',
        () => sc.scrollBy({ left:  300, behavior: 'smooth' }));

    // ── Grid / List toggle ──
    document.getElementById('gridBtn')?.addEventListener('click', () => {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg';
    });
    document.getElementById('listBtn')?.addEventListener('click', () => {
        document.getElementById('roomsGrid').className = 'grid grid-cols-1 gap-lg';
    });

    // ── Branch filter ──
    let activeCity = null;

    function filterByCity(city, cardEl) {
        // Toggle off if same city clicked again
        if (activeCity === city) { clearBranchFilter(); return; }

        activeCity = city;

        // Visual state on cards
        document.querySelectorAll('.destination-card').forEach(c => {
            const ring = c.querySelector('.branch-active-ring');
            const isActive = c.dataset.city === city;
            ring.style.opacity = isActive ? '1' : '0';
            c.style.opacity    = isActive ? '1' : '0.5';
        });

        // Update destination input + show bar
        document.getElementById('destinationInput').value = city;
        const bar = document.getElementById('activeBranchBar');
        document.getElementById('activeBranchName').textContent = city;
        bar.classList.remove('hidden');

        // TODO (Week 2): trigger Supabase room query filtered by property city
        console.log('Filtering rooms for branch:', city);
    }

    function clearBranchFilter() {
        activeCity = null;
        document.querySelectorAll('.destination-card').forEach(c => {
            c.querySelector('.branch-active-ring').style.opacity = '0';
            c.style.opacity = '1';
        });
        document.getElementById('destinationInput').value = '';
        document.getElementById('activeBranchBar').classList.add('hidden');
    }
</script>
}
