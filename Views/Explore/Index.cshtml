                        <p class="text-white/70 text-[11px] font-bold uppercase tracking-widest mt-1">United States 🇺🇸</p>
                    </div>
                    <div class="ring"></div>
                </div>
                <div class="flex justify-between items-center px-1">
                    <span class="text-label-md font-semibold text-on-surface">1,240 Properties</span>
                    <span class="material-symbols-outlined text-primary">arrow_right_alt</span>
                </div>
            </div>

            <!-- 2. London -->
