                    <img class="w-full h-full object-cover object-center"
                         src="~/images/explore_page/caracasVEN.jpg" alt="Caracas" />
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/10 to-transparent flex flex-col justify-end p-6">
