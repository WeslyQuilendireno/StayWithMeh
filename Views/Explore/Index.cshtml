@{
    ViewData["Title"]      = "Explore Destinations & Rooms";
    ViewData["ActivePage"] = "Explore";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ═══════════════════════════════════════════════
     SEARCH BAR
═══════════════════════════════════════════════ -->
<section class="mt-lg px-gutter max-w-[1440px] mx-auto">
    <form asp-controller="Explore" asp-action="Index" method="get">

        <!-- Main search pill -->
        <div class="bg-surface-container-lowest rounded-full shadow-md border border-outline-variant p-2
                    flex flex-col lg:flex-row items-stretch gap-xs">

            <!-- Destination -->
            <div class="flex-1 flex items-center px-4 py-3 gap-3
                        border-b lg:border-b-0 lg:border-r border-outline-variant">
                <span class="material-symbols-outlined text-primary">location_on</span>
                <div class="flex flex-col w-full">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Destination</span>
                    <input class="border-none p-0 focus:ring-0 text-body-md w-full bg-transparent placeholder-on-surface-variant"
                           placeholder="Enter city, area or property name"
                           type="text" name="destination" value="@ViewData["Destination"]" />
                </div>
            </div>

            <!-- Dates -->
            <div class="flex-1 flex items-center px-4 py-3 gap-3
                        border-b lg:border-b-0 lg:border-r border-outline-variant">
                <span class="material-symbols-outlined text-primary">calendar_month</span>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Check-in</span>
                    <input type="date" name="checkIn" value="@ViewData["CheckIn"]"
                           class="border-none p-0 focus:ring-0 text-body-md font-medium bg-transparent" />
                </div>
                <span class="mx-2 text-outline">|</span>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Check-out</span>
                    <input type="date" name="checkOut" value="@ViewData["CheckOut"]"
                           class="border-none p-0 focus:ring-0 text-body-md font-medium bg-transparent" />
                </div>
            </div>

            <!-- Guests -->
            <div class="flex-1 flex items-center px-4 py-3 gap-3">
                <span class="material-symbols-outlined text-primary">group</span>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-outline">Rooms &amp; Guests</span>
                    <span class="text-body-md font-medium">1 Room, 2 Guests</span>
                </div>
            </div>

            <!-- Search btn -->
            <button type="submit"
                    class="bg-primary text-on-primary px-10 py-4 rounded-full font-headline-sm
                           flex items-center justify-center gap-2 hover:scale-[1.02] transition-transform">
                Search <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>

        <!-- Filter row -->
        <div class="mt-md flex flex-wrap items-center gap-md">
            <div class="flex items-center gap-2 bg-surface-container rounded-lg px-3 py-1.5 border border-outline-variant">
                <span class="text-label-sm text-on-surface-variant uppercase">Type:</span>
                <select name="type" class="bg-transparent border-none text-label-md p-0 pr-6 focus:ring-0">
                    <option>All Types</option>
                    <option>Standard</option>
                    <option>Deluxe</option>
                    <option>Business Suite</option>
                    <option>Family Suite</option>
                </select>
            </div>
            <div class="flex items-center gap-2 bg-surface-container rounded-lg px-3 py-1.5 border border-outline-variant">
                <span class="text-label-sm text-on-surface-variant uppercase">Price:</span>
                <input id="priceRange" class="w-32 accent-primary" type="range" min="50" max="1000" value="500" />
                <span id="priceDisplay" class="text-label-sm text-primary font-bold">$500</span>
            </div>
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input class="rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" name="wifi" />
                    <span class="text-label-md">WiFi</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input class="rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" name="pool" />
                    <span class="text-label-md">Pool</span>
                </label>
            </div>
        </div>
    </form>
</section>

<!-- ═══════════════════════════════════════════════
     POPULAR DESTINATIONS  (your own photos)
═══════════════════════════════════════════════ -->
<section class="mt-xl px-gutter max-w-[1440px] mx-auto">
