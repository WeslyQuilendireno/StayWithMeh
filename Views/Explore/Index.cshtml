                    <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/10 to-transparent flex flex-col justify-end p-6">
                        <h3 class="text-white font-headline-md text-headline-md">Melbourne</h3>
                        <p class="text-white/70 text-[11px] font-bold uppercase tracking-widest mt-1">Australia 🇦🇺</p>
                    </div>
                    <div class="ring"></div>
                </div>
                <div class="flex justify-between items-center px-1">
