@model StayWithMeh.Models.ReceptionistDashboardViewModel
@{
    ViewData["Title"]          = "Dashboard Overview";
    ViewData["ActiveStaffPage"] = "Overview";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div class="grid grid-cols-12 gap-lg">

    <!-- ── Left column: Room Grid + Occupancy Card ── -->
    <div class="col-span-12 lg:col-span-8 flex flex-col gap-lg">

        <!-- Room Status Grid -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant/10 overflow-hidden">
            <div class="p-lg border-b border-outline-variant/10">
                <div class="flex items-start justify-between flex-wrap gap-md">
                    <div>
                        <h2 class="text-headline-sm font-headline-sm text-primary">Room Status Grid</h2>
                        <p class="text-body-sm text-on-surface-variant mt-1">Live view of current room inventory across all floors</p>
                    </div>
                    <!-- Floor filter tabs -->
                    <div class="flex gap-2" id="floorTabs">
                        <button onclick="filterFloor('all', this)"
                                class="floor-tab px-md py-xs rounded-full text-label-sm font-bold bg-primary text-on-primary transition-colors">
                            All Floors
                        </button>
                        @foreach (var floor in Model.Rooms.Select(r => r.Floor).Where(f => f.HasValue).Select(f => f!.Value).Distinct().OrderBy(f => f))
                        {
                            <button onclick="filterFloor('@floor', this)"
                                    class="floor-tab px-md py-xs rounded-full text-label-sm font-bold bg-surface-container text-on-surface-variant hover:bg-primary hover:text-on-primary transition-colors">
                                Floor @floor
                            </button>
                        }
                    </div>
                </div>

                <!-- Status legend -->
                <div class="flex flex-wrap gap-md mt-md">
                    <div class="flex items-center gap-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                        <span class="text-label-sm text-on-surface-variant">Occupied (@Model.OccupiedCount)</span>
                    </div>
                    <div class="flex items-center gap-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
                        <span class="text-label-sm text-on-surface-variant">Available (@Model.AvailableCount)</span>
                    </div>
                    <div class="flex items-center gap-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                        <span class="text-label-sm text-on-surface-variant">Maintenance (@Model.MaintenanceCount)</span>
                    </div>
                    <div class="flex items-center gap-xs">
                        <span class="w-2.5 h-2.5 rounded-full bg-orange-400"></span>
                        <span class="text-label-sm text-on-surface-variant">Dirty (@Model.DirtyCount)</span>
                    </div>
                </div>
            </div>

            <!-- Room cards grid -->
            <div class="p-lg grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-md" id="roomGrid">
                @foreach (var room in Model.Rooms.OrderBy(r => r.RoomNumber))
                {
                    var (bg, text, dot) = room.Status switch
                    {
                        "occupied"    => ("bg-primary text-on-primary",                     "text-on-primary/70",       "bg-white"),
                        "maintenance" => ("bg-amber-50 border border-amber-200 text-amber-900", "text-amber-700",       "bg-amber-400"),
                        "dirty"       => ("bg-orange-50 border border-orange-200 text-orange-900", "text-orange-700",   "bg-orange-400"),
                        _             => ("bg-surface-container-low border border-outline-variant/20 text-on-surface", "text-on-surface-variant", "bg-green-500")
                    };

                    <div class="room-card rounded-xl p-md flex flex-col gap-xs cursor-pointer
                                hover:shadow-md hover:-translate-y-0.5 transition-all @bg"
                         data-floor="@room.Floor"
                         data-room-id="@room.Id"
                         onclick="openRoomDetail('@room.Id', '@room.RoomNumber', '@room.Status', '@room.RoomType')">
                        <div class="flex items-center justify-between">
                            <span class="text-headline-sm font-black">@room.RoomNumber</span>
                            <span class="material-symbols-outlined text-[16px] opacity-50">lock</span>
                        </div>
                        <div class="flex items-center gap-xs mt-xs">
                            <span class="w-2 h-2 rounded-full @dot"></span>
                            <span class="text-label-sm font-bold capitalize">@room.Status</span>
                        </div>
                        <span class="text-[11px] @text mt-xs">@room.RoomType</span>
                        @if (room.Floor.HasValue)
                        {
                            <span class="text-[11px] @text opacity-70">Floor @room.Floor</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Occupancy Peak Card -->
        <div class="bg-primary text-on-primary p-lg rounded-2xl relative overflow-hidden">
            <div class="relative z-10">
                <h3 class="text-headline-sm font-headline-sm">Occupancy Peak Today</h3>
                @{
                    var occupancyPct = Model.Rooms.Count > 0
                        ? (int)Math.Round((double)Model.OccupiedCount / Model.Rooms.Count * 100)
                        : 0;
                }
                <p class="text-body-md opacity-80 mt-1">@occupancyPct% capacity currently occupied</p>
                <div class="mt-lg flex gap-lg">
                    <div>
                        <p class="text-display-lg font-bold">@Model.Bookings.Count</p>
                        <p class="text-label-sm opacity-60">Total Bookings</p>
                    </div>
                    <div class="border-l border-on-primary/20 pl-lg">
                        <p class="text-display-lg font-bold">@Model.TodayArrivals.Count</p>
                        <p class="text-label-sm opacity-60">Today's Arrivals</p>
                    </div>
                </div>
            </div>
            <!-- Decorative sparkline SVG -->
            <div class="hidden md:block absolute right-lg bottom-lg w-64 h-32 opacity-20">
                <svg class="w-full h-full stroke-current" fill="none" stroke-width="2" viewBox="0 0 100 50">
                    <path d="M0 45 Q 25 45, 40 25 T 80 15 T 100 5" stroke-linecap="round"></path>
                </svg>
            </div>
            <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-primary-container rounded-full blur-3xl opacity-30 pointer-events-none"></div>
        </div>
    </div>

    <!-- ── Right column: Quick Actions + Arrivals + Weather ── -->
    <aside class="col-span-12 lg:col-span-4 flex flex-col gap-lg">

        <!-- Quick Actions -->
        <div class="bg-surface-container-lowest p-lg rounded-2xl shadow-sm border border-outline-variant/10">
            <h3 class="text-label-sm font-bold text-on-surface-variant uppercase tracking-widest mb-md">Quick Actions</h3>
            <div class="flex flex-col gap-md">
                <a asp-controller="Room" asp-action="Index"
                   class="flex items-center gap-md p-md bg-primary text-on-primary rounded-xl
                          hover:opacity-90 transition-all group">
                    <span class="material-symbols-outlined bg-white/20 p-base rounded-lg group-hover:scale-110 transition-transform">add_circle</span>
                    <span class="text-label-md font-bold">New Booking</span>
                </a>
                <div class="grid grid-cols-2 gap-md">
                    <button class="flex flex-col items-center justify-center gap-sm p-md
                                   bg-secondary-container text-on-surface rounded-xl
                                   hover:bg-primary-container hover:text-on-primary-container transition-all">
                        <span class="material-symbols-outlined">login</span>
                        <span class="text-label-sm font-bold">Check-in</span>
                    </button>
                    <button class="flex flex-col items-center justify-center gap-sm p-md
                                   bg-secondary-container text-on-surface rounded-xl
                                   hover:bg-primary-container hover:text-on-primary-container transition-all">
                        <span class="material-symbols-outlined">logout</span>
                        <span class="text-label-sm font-bold">Check-out</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Upcoming Arrivals -->
        <div class="bg-surface-container-lowest flex-1 rounded-2xl shadow-sm border border-outline-variant/10 overflow-hidden flex flex-col">
            <div class="p-lg border-b border-outline-variant/10 flex justify-between items-center">
                <div>
                    <h3 class="text-label-sm font-bold text-on-surface-variant uppercase tracking-widest">Upcoming Arrivals</h3>
                    <p class="text-body-sm text-on-surface-variant">Today, @DateTime.Now.ToString("MMM dd")</p>
                </div>
                <span class="bg-primary-container text-on-primary-container px-md py-xs rounded-full text-label-sm font-bold">
                    @Model.TodayArrivals.Count Total
                </span>
            </div>
            <div class="flex-1 overflow-y-auto custom-scrollbar p-lg space-y-xs">
                @if (!Model.TodayArrivals.Any())
                {
                    <div class="text-center py-xl">
                        <span class="material-symbols-outlined text-outline text-[36px] mb-sm block">event_available</span>
                        <p class="text-body-sm text-on-surface-variant">No arrivals scheduled for today.</p>
                    </div>
                }
                else
                {
                    @foreach (var booking in Model.TodayArrivals)
                    {
                        var guest = Model.Guests.FirstOrDefault(g => g.Id == booking.GuestId);
                        var initials = guest?.FullName is not null
                            ? string.Concat(guest.FullName.Split(' ').Take(2).Select(w => w[0]))
                            : "??";

                        <div class="flex items-center gap-md p-md hover:bg-surface-container rounded-xl
                                    transition-colors cursor-pointer border border-transparent hover:border-outline-variant/20">
                            <div class="w-12 h-12 rounded-full bg-secondary-container flex items-center
                                        justify-center text-on-surface font-bold text-label-md shrink-0">
                                @initials
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-label-md font-bold text-on-surface leading-none truncate">
                                    @(guest?.FullName ?? "Unknown Guest")
                                </p>
                                <p class="text-label-sm text-on-surface-variant mt-1">
                                    Booking #@booking.Id.Substring(0, 8).ToUpper()
                                </p>
                            </div>
                            <div class="text-right shrink-0">
                                <p class="text-label-md font-bold text-primary">
                                    @booking.CheckIn.ToString("HH:mm")
                                </p>
                                <p class="text-[10px] text-on-surface-variant uppercase font-bold">ETA</p>
                            </div>
                        </div>
                    }
                }
            </div>
            <button class="p-md text-center text-label-sm font-bold text-primary
                           hover:bg-surface-container transition-colors border-t border-outline-variant/10">
                View All Arrivals
            </button>
        </div>

        <!-- Weather widget — branch location, static for now -->
        <div class="bg-primary-container text-on-primary-container p-lg rounded-2xl flex items-center gap-lg">
            <span class="material-symbols-outlined text-4xl">cloud</span>
            <div>
                <p class="text-headline-sm font-bold">--°C</p>
                <p class="text-label-sm opacity-80">Weather · New York, USA</p>
            </div>
            <div class="ml-auto opacity-20">
                <span class="material-symbols-outlined text-5xl">location_on</span>
            </div>
        </div>

    </aside>
</div>

<!-- Room Detail Modal — opens when a room card is clicked -->
<div id="roomDetailModal"
     class="hidden fixed inset-0 z-50 bg-primary/40 backdrop-blur-sm flex items-center justify-center p-lg"
     onclick="closeRoomDetail(event)">
    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md p-lg">
        <div class="flex items-center justify-between mb-lg">
            <h3 class="text-headline-sm font-headline-sm text-primary" id="modalRoomTitle">Room Detail</h3>
            <button onclick="document.getElementById('roomDetailModal').classList.add('hidden')"
                    class="w-9 h-9 rounded-full hover:bg-surface-container flex items-center justify-center transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
        </div>
        <div class="space-y-md">
            <div class="grid grid-cols-2 gap-md">
                <div class="bg-surface-container p-md rounded-xl">
                    <p class="text-label-sm text-on-surface-variant uppercase tracking-widest mb-xs">Status</p>
                    <p class="text-label-md font-bold text-on-surface capitalize" id="modalRoomStatus">—</p>
                </div>
                <div class="bg-surface-container p-md rounded-xl">
                    <p class="text-label-sm text-on-surface-variant uppercase tracking-widest mb-xs">Type</p>
                    <p class="text-label-md font-bold text-on-surface" id="modalRoomType">—</p>
                </div>
            </div>
            <div class="bg-surface-container p-md rounded-xl">
                <p class="text-label-sm text-on-surface-variant uppercase tracking-widest mb-md">Update Status</p>
                <div class="grid grid-cols-2 gap-sm">
                    <button onclick="updateRoomStatus('available')"
                            class="py-sm px-md rounded-lg text-label-sm font-bold bg-green-100 text-green-800 hover:bg-green-200 transition-colors">
                        Available
                    </button>
                    <button onclick="updateRoomStatus('occupied')"
                            class="py-sm px-md rounded-lg text-label-sm font-bold bg-primary/10 text-primary hover:bg-primary/20 transition-colors">
                        Occupied
                    </button>
                    <button onclick="updateRoomStatus('dirty')"
                            class="py-sm px-md rounded-lg text-label-sm font-bold bg-orange-100 text-orange-800 hover:bg-orange-200 transition-colors">
                        Dirty
                    </button>
                    <button onclick="updateRoomStatus('maintenance')"
                            class="py-sm px-md rounded-lg text-label-sm font-bold bg-amber-100 text-amber-800 hover:bg-amber-200 transition-colors">
                        Maintenance
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var activeRoomId = null;

    // Filter room cards by floor — 'all' shows every card
    function filterFloor(floor, btn) {
        document.querySelectorAll('.floor-tab').forEach(t => {
            t.classList.remove('bg-primary', 'text-on-primary');
            t.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        btn.classList.add('bg-primary', 'text-on-primary');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

        document.querySelectorAll('.room-card').forEach(card => {
            card.style.display = (floor === 'all' || card.dataset.floor === floor) ? 'flex' : 'none';
        });
    }

    function openRoomDetail(id, number, status, type) {
        activeRoomId = id;
        document.getElementById('modalRoomTitle').textContent = 'Room ' + number;
        document.getElementById('modalRoomStatus').textContent = status;
        document.getElementById('modalRoomType').textContent = type;
        document.getElementById('roomDetailModal').classList.remove('hidden');
    }

    function closeRoomDetail(e) {
        if (e.target === document.getElementById('roomDetailModal')) {
            document.getElementById('roomDetailModal').classList.add('hidden');
        }
    }

    // Sends a PATCH to update room status — wired to ReceptionistController.UpdateRoomStatus()
    async function updateRoomStatus(newStatus) {
        if (!activeRoomId) return;
        try {
            const res = await fetch('/Receptionist/UpdateRoomStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ roomId: activeRoomId, status: newStatus })
            });
            if (!res.ok) throw new Error('Update failed');
            document.getElementById('modalRoomStatus').textContent = newStatus;
            document.getElementById('roomDetailModal').classList.add('hidden');
            location.reload();
        } catch {
            alert('Failed to update room status. Please try again.');
        }
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') document.getElementById('roomDetailModal').classList.add('hidden');
    });
</script>
}
